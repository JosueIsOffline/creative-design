---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import ProductModal from '../components/ProductModal.astro';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Diseño gráfico y sublimación: artículos personalizados hechos con amor, por Ailyn Japa.' } = Astro.props;
const instagram = import.meta.env.INSTAGRAM_URL;
const whatsapp = import.meta.env.WHATSAPP_NUMBER;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo.jpg" />
    <link rel="icon" href="/logo.jpg" type="image/jpeg" />
    <title>{title}</title>
  </head>
  <body class="bg-brand-black text-white font-display">
    <header class="sticky top-0 z-40 flex items-center justify-between gap-4 px-6 py-4 bg-brand-black/80 backdrop-blur-md border-b border-gray-800">
      <a href="/" class="flex items-center gap-2 text-white shrink-0">
        <img src="/logo.jpg" alt="Creative Design" class="h-8 w-8 rounded-full" />
        <span class="font-semibold">Creative Design</span>
      </a>
      <nav class="hidden sm:flex items-center gap-6 text-sm text-gray-300" aria-label="Principal">
        <a href="/catalogo" class="hover:text-brand-lilac transition-colors">Catálogo</a>
        <a href="/#sobre-la-marca" class="hover:text-brand-lilac transition-colors">Nosotros</a>
      </nav>
      <div class="flex items-center gap-3 shrink-0">
        <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-8 h-8 rounded-full border border-gray-700 flex items-center justify-center text-gray-300 hover:text-brand-lilac hover:border-brand-lilac transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4 fill-current">
            <path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.9.2 2.4.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.5.4 1.2.4 2.4.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.9-.4 2.4-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.5.2-1.2.4-2.4.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.9-.2-2.4-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.5-.4-1.2-.4-2.4C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.9.4-2.4.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.5-.2 1.2-.4 2.4-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1 0-1.5.2-1.9.3-.5.2-.8.4-1.1.7-.3.3-.5.6-.7 1.1-.1.4-.3.9-.3 1.9-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c0 1 .2 1.5.3 1.9.2.5.4.8.7 1.1.3.3.6.5 1.1.7.4.1.9.3 1.9.3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1 0 1.5-.2 1.9-.3.5-.2.8-.4 1.1-.7.3-.3.5-.6.7-1.1.1-.4.3-.9.3-1.9.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c0-1-.2-1.5-.3-1.9-.2-.5-.4-.8-.7-1.1-.3-.3-.6-.5-1.1-.7-.4-.1-.9-.3-1.9-.3-1.2-.1-1.6-.1-4.7-.1zm0 3.5a4.5 4.5 0 110 9 4.5 4.5 0 010-9zm0 1.8a2.7 2.7 0 100 5.4 2.7 2.7 0 000-5.4zm5.7-2a1.1 1.1 0 11-2.2 0 1.1 1.1 0 012.2 0z"/>
          </svg>
        </a>
        <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-8 h-8 rounded-full border border-gray-700 flex items-center justify-center text-gray-300 hover:text-brand-lilac hover:border-brand-lilac transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-4 h-4 fill-current">
            <path d="M16 3C9.4 3 4 8.4 4 15c0 2.2.6 4.3 1.7 6.1L4 29l8.1-1.7C13.8 28 14.9 28 16 28c6.6 0 12-5.4 12-13S22.6 3 16 3zm0 23.2c-1.1 0-2.2-.2-3.2-.6l-.5-.2-4.8 1 1-4.7-.3-.5C7.1 19.6 6.4 17.9 6.4 16c0-5.3 4.3-9.6 9.6-9.6s9.6 4.3 9.6 9.6-4.3 9.6-9.6 9.6z"/>
          </svg>
        </a>
      </div>
    </header>
    <slot />
    <Footer />
    <WhatsAppButton />
    <ProductModal />
  </body>
</html>
