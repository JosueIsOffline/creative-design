---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import ProductModal from '../components/ProductModal.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { ClientRouter } from 'astro:transitions';
interface Props {
  title: string;
  description?: string;
  hideFooter?: boolean;
  /** The cart page's main action already goes to WhatsApp: drop the floating bubble there. */
  hideWhatsApp?: boolean;
}
const {
  title,
  description = 'Diseño gráfico y sublimación: artículos personalizados hechos con amor, por Ailyn Japa.',
  hideFooter = false,
  hideWhatsApp = false,
} = Astro.props;
// Christmas season window (MM-DD), inclusive; it may wrap the new year.
const christmas = { start: import.meta.env.CHRISTMAS_START || '12-01', end: import.meta.env.CHRISTMAS_END || '01-06' };
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        // Re-applied after every client-side swap, which resets <html>'s classes.
        function flags() {
          var html = document.documentElement;
          html.classList.add('js');
        }
        flags();
        document.addEventListener('astro:after-swap', flags);
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'light' || stored === 'dark'
            ? stored
            : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <!-- Christmas layer: on by date in the visitor's browser, so it starts and ends without a rebuild.
         ?christmas=1 previews it any day (for the session), ?christmas=0 turns the preview off. -->
    <script is:inline define:vars={{ christmas }}>
      (function () {
        function apply() {
          var d = new Date();
          var md = ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
          var on = christmas.start <= christmas.end ? md >= christmas.start && md <= christmas.end : md >= christmas.start || md <= christmas.end;
          try {
            var q = new URLSearchParams(location.search).get('christmas');
            if (q === '1') sessionStorage.setItem('christmas-preview', '1');
            if (q === '0') sessionStorage.removeItem('christmas-preview');
            if (sessionStorage.getItem('christmas-preview') === '1') on = true;
          } catch (e) {}
          document.documentElement.classList.toggle('is-christmas', on);
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo.jpg" />
    <link rel="icon" href="/logo.jpg" type="image/jpeg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground font-display">
    <SiteHeader />
    <slot />
    {!hideFooter && <Footer transition:persist="footer" />}
    {!hideWhatsApp && <WhatsAppButton transition:persist="whatsapp" />}
    <ProductModal transition:persist="product-modal" />
    <script>
      import '../scripts/theme';
      import '../scripts/hover-fx';
      import '../scripts/micro-interactions';
      import '../scripts/header';
      import '../scripts/cart';
      import '../scripts/smooth-scroll';
    </script>
  </body>
</html>
