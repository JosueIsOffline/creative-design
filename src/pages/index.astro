---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import Marquee from '../components/Marquee.astro';
import HowToOrder from '../components/HowToOrder.astro';
import Gallery from '../components/Gallery.astro';
import About from '../components/About.astro';
import Glitter from '../components/Glitter.astro';
import Snow from '../components/Snow.astro';
import FinalCta from '../components/FinalCta.astro';
import { Icon } from 'astro-icon/components';
import ProductCard from '../components/ProductCard.astro';
import { fetchCatalog } from '../lib/sheets';

const products = await fetchCatalog(import.meta.env.CATALOG_CSV_URL);
const featured = products.slice(0, 6);
// Christmas season: the Sheet's Navidad category (slug 'navidad'), shown only with html.is-christmas.
const gifts = products.filter((p) => p.slug === 'navidad').slice(0, 6);
const gallery = products.slice(0, 8);
---
<BaseLayout title="Inicio">
  <div id="intro-overlay" class="fixed inset-0 z-[100] hidden items-center justify-center bg-background" data-intro>
    <span class="font-display text-2xl font-semibold text-accent">Creative Design</span>
  </div>

  <HeroScene />
  <Snow />

  <div class="after-hero">

  <Marquee items={['Tazas', 'Vasos térmicos', 'Camisetas', 'Hoodies', 'Bolsos', 'Fundas', 'Llaveros']} />

  {gifts.length > 0 && (
    <section id="gifts" class="gifts" data-season aria-labelledby="gifts-title">
      <div class="max-w-6xl mx-auto px-6">
        <div class="gifts__head">
          <div>
            <span class="gifts__eyebrow"><span aria-hidden="true">✨</span> Temporada navideña</span>
            <h2 id="gifts-title" class="gifts__title">Regalos de <span class="gifts__script">Navidad</span></h2>
            <p class="gifts__lead">Piezas personalizadas, listas para envolver y regalar.</p>
          </div>
          <a href="/catalogo/navidad" class="gifts__all">Ver todo el catálogo de Navidad <span aria-hidden="true">→</span></a>
        </div>
        <div class="gifts__grid">
          {gifts.map((product) => (
            <div class="gift">
              <span class="gift__tag" aria-hidden="true"><span class="gift__hole"></span>RD$ {product.price.toLocaleString('es-DO')}</span>
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <HowToOrder />

  {featured.length > 0 && (
    <section id="destacados" class="relative py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 data-gsap="kinetic-heading" class="font-display text-2xl font-semibold text-accent">Destacados</h2>
          <a href="/catalogo" class="js-hover-fx inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent transition-colors">
            Ver catálogo completo
            <Icon name="line-md:arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-featured>
          {featured.map((product) => (
            <div data-featured-item>
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <Glitter />
  {gallery.length > 0 && <Gallery products={gallery} />}

  <About />

  <FinalCta products={products} />
  </div>
</BaseLayout>

<script>
  import '../scripts/scroll-reveal';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Destacados: a fixed grid; each card makes its entrance as its row
  // scrolls in — rising out of a soft blur, staggered across the row, its
  // photo opening from a cropped frame (the same gesture as Ailyn's photo).
  function mountFeatured() {
    const grid = document.querySelector<HTMLElement>('[data-featured]');
    if (!grid || grid.dataset.featuredMounted) return;
    grid.dataset.featuredMounted = 'true';
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const items = gsap.utils.toArray<HTMLElement>('[data-featured-item]', grid);
      gsap.set(items, { opacity: 0, y: 70, scale: 0.94, filter: 'blur(10px)' });
      items.forEach((el) => {
        const img = el.querySelector<HTMLElement>('[data-tilt]');
        if (img) gsap.set(img, { clipPath: 'inset(14% 10% 14% 10% round 16px)' });
      });
      ScrollTrigger.batch(items, {
        start: 'top 88%',
        once: true,
        onEnter: (batch) => {
          gsap.to(batch, { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)', duration: 1.1, ease: 'expo.out', stagger: 0.12, clearProps: 'filter,transform' });
          batch.forEach((el, i) => {
            const img = el.querySelector<HTMLElement>('[data-tilt]');
            if (img) gsap.to(img, { clipPath: 'inset(0% 0% 0% 0% round 16px)', duration: 1.3, ease: 'expo.out', delay: 0.08 + i * 0.12, clearProps: 'clipPath' });
          });
        },
      });
    });
  }

  document.addEventListener('astro:page-load', mountFeatured);

  // First-visit intro (adapted from the Halo reference's Intro): a brief
  // flourish shown once per session, skipped on repeat visits within the
  // same session and under reduced motion. The overlay starts with the
  // `hidden` class, so without JavaScript it never shows at all — it is
  // only ever revealed here, never by default.
  function mountIntro() {
    const overlay = document.querySelector<HTMLElement>('[data-intro]');
    if (!overlay || overlay.dataset.introMounted) return;
    overlay.dataset.introMounted = 'true';

    let seen = false;
    try {
      seen = sessionStorage.getItem('intro-seen') === '1';
    } catch {
      // sessionStorage can throw in restrictive private-browsing modes —
      // treat it as unseen rather than blocking the intro.
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches || seen) {
      overlay.remove();
      return;
    }

    try {
      sessionStorage.setItem('intro-seen', '1');
    } catch {
      // Nothing to persist to; the intro still plays once for this load.
    }

    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';

    gsap
      .timeline({
        onComplete: () => {
          overlay.remove();
          document.body.style.overflow = '';
        },
      })
      .from(overlay.querySelector('span'), { opacity: 0, scale: 0.9, duration: 0.4, ease: 'power2.out' })
      .to(overlay, { opacity: 0, duration: 0.4, ease: 'power2.inOut', delay: 0.3 });
  }

  document.addEventListener('astro:page-load', mountIntro);
</script>

<style>
  /* Christmas gifts: the price hangs from each photo as a gift tag on a string. */
  .gifts { position: relative; padding: 96px 0 64px; }
  .gifts__head { display: flex; align-items: end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 48px; }
  .gifts__eyebrow { font: 500 11px/1 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-muted); }
  .gifts__title { margin-top: 12px; font: 700 clamp(2.5rem, 6vw, 4.5rem)/0.95 var(--font-display); letter-spacing: -0.04em; }
  .gifts__script { font-family: 'Dancing Script', cursive; font-weight: 600; letter-spacing: 0; color: var(--lilac); font-size: 1.15em; }
  .gifts__lead { margin-top: 16px; color: var(--color-muted); max-width: 40ch; }
  .gifts__all { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 14px; color: var(--color-foreground); text-decoration: underline; text-underline-offset: 4px; }
  .gifts__all span { transition: translate 300ms cubic-bezier(0.16, 1, 0.3, 1); }
  .gifts__all:hover span { translate: 3px 0; }
  .gifts__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 32px 24px; }
  .gift { position: relative; }
  .gift :global(.card-price) { display: none; } /* the tag carries the price */
  .gift__tag {
    position: absolute; z-index: 3; top: 14px; left: 18px; display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 12px 7px 22px; background: #f6efe3; color: #1d1a16; font: 600 13px/1 var(--font-mono); letter-spacing: 0.02em;
    clip-path: polygon(12px 0, 100% 0, 100% 100%, 12px 100%, 0 50%);
    box-shadow: 0 6px 14px -6px rgb(0 0 0 / 0.4);
    rotate: -7deg; transform-origin: 6px 50%;
    transition: rotate 700ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  /* The string it hangs from. */
  .gift__tag::before { content: ''; position: absolute; left: -10px; top: 50%; width: 22px; height: 1.5px; background: #d62839; translate: 0 -50%; rotate: -24deg; }
  .gift__hole { position: absolute; left: 9px; top: 50%; width: 6px; height: 6px; border-radius: 999px; background: rgb(0 0 0 / 0.25); translate: 0 -50%; }
  .gift:hover .gift__tag { rotate: 4deg; }
  @media (prefers-reduced-motion: reduce) { .gift__tag { transition: none; } }
</style>
