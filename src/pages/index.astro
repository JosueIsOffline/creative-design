---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import Marquee from '../components/Marquee.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import About from '../components/About.astro';
import FinalCta from '../components/FinalCta.astro';
import { Icon } from 'astro-icon/components';
import ProductCard from '../components/ProductCard.astro';
import { fetchCatalog } from '../lib/sheets';

const products = await fetchCatalog(import.meta.env.CATALOG_CSV_URL);
const destacados = products.slice(0, 6);
const galeria = products.slice(0, 8);
---
<BaseLayout title="Inicio">
  <div id="intro-overlay" class="fixed inset-0 z-[100] hidden items-center justify-center bg-background" data-intro>
    <span class="font-display text-2xl font-semibold text-accent">Creative Design</span>
  </div>

  <HeroScene />


  <Marquee items={['Tazas', 'Vasos', 'Bolsos', 'Fundas', 'Camisetas', 'Llaveros', 'Identidad Visual', 'Flyers', 'Papelería', 'Personalización', 'Sublimación', 'Redes Sociales']} />

  <Services />

  {destacados.length > 0 && (
    <section id="destacados" class="relative py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-end justify-between mb-8">
          <h2 data-gsap="kinetic-heading" class="font-display text-2xl font-semibold text-accent">Destacados</h2>
          <a href="/catalogo" class="js-hover-fx inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent transition-colors">
            Ver catálogo completo
            <Icon name="line-md:arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
      <div class="lg:overflow-hidden" data-rail>
        <div
          class="flex gap-6 px-6 pb-6 lg:pb-0 overflow-x-auto lg:overflow-visible snap-x snap-mandatory lg:snap-none [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-rail-track
        >
          {destacados.map((product) => (
            <div class="w-[75vw] sm:w-[320px] lg:w-[320px] shrink-0 snap-start">
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {galeria.length > 0 && <Gallery products={galeria} />}

  <About historia="Creative Design, de Ailyn Japa, crea artículos personalizados por sublimación (tazas, camisetas, fundas, llaveros y más) y servicios de diseño gráfico a medida: invitaciones, catálogos, banners y contenido para redes. Creatividad que conecta y vende." />

  <FinalCta />
</BaseLayout>

<script>
  import '../scripts/scroll-reveal';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Destacados rail: on desktop the section pins and vertical scroll drives
  // the row horizontally (adapted from the Halo reference's WorkRail); on
  // phones/tablets it's left as a plain swipeable row (data-rail-track's
  // own overflow-x-auto), which is simpler and feels more native to touch.
  function mountRail() {
    document.querySelectorAll<HTMLElement>('[data-rail]').forEach((root) => {
      if (root.dataset.railMounted) return;
      root.dataset.railMounted = 'true';

      const track = root.querySelector<HTMLElement>('[data-rail-track]');
      if (!track) return;

      const mm = gsap.matchMedia();
      mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
        const distance = track.scrollWidth - track.clientWidth;
        if (distance <= 0) return;

        gsap.to(track, {
          x: -distance,
          ease: 'none',
          scrollTrigger: {
            trigger: root,
            start: 'top top',
            end: `+=${distance}`,
            pin: true,
            scrub: 0.6,
            invalidateOnRefresh: true,
          },
        });
      });
    });
  }

  document.addEventListener('astro:page-load', mountRail);

  // First-visit intro (adapted from the Halo reference's Intro): a brief
  // flourish shown once per session, skipped on repeat visits within the
  // same session and under reduced motion. The overlay starts with the
  // `hidden` class, so without JavaScript it never shows at all — it is
  // only ever revealed here, never by default.
  function mountIntro() {
    const overlay = document.querySelector<HTMLElement>('[data-intro]');
    if (!overlay || overlay.dataset.introMounted) return;
    overlay.dataset.introMounted = 'true';

    let seen = false;
    try {
      seen = sessionStorage.getItem('intro-seen') === '1';
    } catch {
      // sessionStorage can throw in restrictive private-browsing modes —
      // treat it as unseen rather than blocking the intro.
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches || seen) {
      overlay.remove();
      return;
    }

    try {
      sessionStorage.setItem('intro-seen', '1');
    } catch {
      // Nothing to persist to; the intro still plays once for this load.
    }

    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';

    gsap
      .timeline({
        onComplete: () => {
          overlay.remove();
          document.body.style.overflow = '';
        },
      })
      .from(overlay.querySelector('span'), { opacity: 0, scale: 0.9, duration: 0.4, ease: 'power2.out' })
      .to(overlay, { opacity: 0, duration: 0.4, ease: 'power2.inOut', delay: 0.3 });
  }

  document.addEventListener('astro:page-load', mountIntro);
</script>
