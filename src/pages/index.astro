---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import Marquee from '../components/Marquee.astro';
import HowToOrder from '../components/HowToOrder.astro';
import Gallery from '../components/Gallery.astro';
import About from '../components/About.astro';
import Glitter from '../components/Glitter.astro';
import FinalCta from '../components/FinalCta.astro';
import { Icon } from 'astro-icon/components';
import ProductCard from '../components/ProductCard.astro';
import { fetchCatalog } from '../lib/sheets';

const products = await fetchCatalog(import.meta.env.CATALOG_CSV_URL);
const destacados = products.slice(0, 6);
const galeria = products.slice(0, 8);
---
<BaseLayout title="Inicio">
  <div id="intro-overlay" class="fixed inset-0 z-[100] hidden items-center justify-center bg-background" data-intro>
    <span class="font-display text-2xl font-semibold text-accent">Creative Design</span>
  </div>

  <HeroScene />

  <div class="after-hero">

  <Marquee items={['Tazas', 'Vasos térmicos', 'Camisetas', 'Hoodies', 'Bolsos', 'Fundas', 'Llaveros']} />

  <HowToOrder />

  {destacados.length > 0 && (
    <section id="destacados" class="relative py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 data-gsap="kinetic-heading" class="font-display text-2xl font-semibold text-accent">Destacados</h2>
          <a href="/catalogo" class="js-hover-fx inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent transition-colors">
            Ver catálogo completo
            <Icon name="line-md:arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-featured>
          {destacados.map((product) => (
            <div data-featured-item>
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <Glitter />
  {galeria.length > 0 && <Gallery products={galeria} />}

  <About />

  <FinalCta products={products} />
  </div>
</BaseLayout>

<script>
  import '../scripts/scroll-reveal';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Destacados: a fixed grid; each card makes its entrance as its row
  // scrolls in — rising out of a soft blur, staggered across the row, its
  // photo opening from a cropped frame (the same gesture as Ailyn's photo).
  function mountFeatured() {
    const grid = document.querySelector<HTMLElement>('[data-featured]');
    if (!grid || grid.dataset.featuredMounted) return;
    grid.dataset.featuredMounted = 'true';
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const items = gsap.utils.toArray<HTMLElement>('[data-featured-item]', grid);
      gsap.set(items, { opacity: 0, y: 70, scale: 0.94, filter: 'blur(10px)' });
      items.forEach((el) => {
        const img = el.querySelector<HTMLElement>('[data-tilt]');
        if (img) gsap.set(img, { clipPath: 'inset(14% 10% 14% 10% round 16px)' });
      });
      ScrollTrigger.batch(items, {
        start: 'top 88%',
        once: true,
        onEnter: (batch) => {
          gsap.to(batch, { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)', duration: 1.1, ease: 'expo.out', stagger: 0.12, clearProps: 'filter,transform' });
          batch.forEach((el, i) => {
            const img = el.querySelector<HTMLElement>('[data-tilt]');
            if (img) gsap.to(img, { clipPath: 'inset(0% 0% 0% 0% round 16px)', duration: 1.3, ease: 'expo.out', delay: 0.08 + i * 0.12, clearProps: 'clipPath' });
          });
        },
      });
    });
  }

  document.addEventListener('astro:page-load', mountFeatured);

  // First-visit intro (adapted from the Halo reference's Intro): a brief
  // flourish shown once per session, skipped on repeat visits within the
  // same session and under reduced motion. The overlay starts with the
  // `hidden` class, so without JavaScript it never shows at all — it is
  // only ever revealed here, never by default.
  function mountIntro() {
    const overlay = document.querySelector<HTMLElement>('[data-intro]');
    if (!overlay || overlay.dataset.introMounted) return;
    overlay.dataset.introMounted = 'true';

    let seen = false;
    try {
      seen = sessionStorage.getItem('intro-seen') === '1';
    } catch {
      // sessionStorage can throw in restrictive private-browsing modes —
      // treat it as unseen rather than blocking the intro.
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches || seen) {
      overlay.remove();
      return;
    }

    try {
      sessionStorage.setItem('intro-seen', '1');
    } catch {
      // Nothing to persist to; the intro still plays once for this load.
    }

    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';

    gsap
      .timeline({
        onComplete: () => {
          overlay.remove();
          document.body.style.overflow = '';
        },
      })
      .from(overlay.querySelector('span'), { opacity: 0, scale: 0.9, duration: 0.4, ease: 'power2.out' })
      .to(overlay, { opacity: 0, duration: 0.4, ease: 'power2.inOut', delay: 0.3 });
  }

  document.addEventListener('astro:page-load', mountIntro);
</script>

