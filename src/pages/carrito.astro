---
// The cart, with the message in view: on the left the pieces (quantity and
// Quitar always at hand; the name unfolds its personalization); on the right
// a phone showing, live, the exact WhatsApp message Ailyn will receive, with
// the piece being edited highlighted. Total + send sit under the phone
// (pinned to the bottom on phones). Logic in scripts/cart-view.ts.
// Motion: the list rises staggered, the phone pops in, digits roll, the
// message's edited lines flash as they change. Discount codes are checked by
// the coupons Web App (scripts/coupons.ts, COUPONS_URL); applying one strikes
// the old total and rolls it down.
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { fetchCatalog } from '../lib/sheets';
const whatsapp = import.meta.env.WHATSAPP_NUMBER;
// The coupons server prices the cart by the Sheet's ID column: map cart keys to those IDs here,
// so carts saved before IDs existed still validate.
const products = await fetchCatalog(import.meta.env.CATALOG_CSV_URL);
const ids = Object.fromEntries(products.filter((p) => p.id).map((p) => [`${p.slug}/${p.productSlug}`, p.id]));
const couponsUrl = import.meta.env.COUPONS_URL ?? '';
const christmasCode = import.meta.env.CHRISTMAS_CODE; // offered with one tap during the Christmas season
---
<BaseLayout title="Tu carrito" hideFooter hideWhatsApp>
  <main class="ms" id="cart-page" data-phone={whatsapp} data-ids={JSON.stringify(ids)} data-coupons-url={couponsUrl}>
    <div class="ms__grid" data-filled hidden>
      <section class="ms__side" aria-labelledby="ms-title">
        <span class="ms__eyebrow">Tu pedido</span>
        <h1 class="ms__title" id="ms-title">Tu carrito</h1>
        <p class="ms__lead">Lo que escribas en cada pieza va directo al mensaje. Así llega todo claro y no hay que preguntar dos veces.</p>
        <div class="ms__meta"><span data-meta-products></span><span data-meta-custom></span></div>
        <ol class="ms__list" data-list></ol>
        <a href="/catalogo" class="ms__more">Seguir agregando piezas</a>
      </section>

      <aside class="ms__preview" aria-label="Así le llega tu pedido">
        <div class="ms__phone">
          <div class="ms__phone-top">
            <img src="/logo.jpg" alt="" class="ms__avatar" />
            <span><strong>Creative Design</strong><small>Así le llega tu pedido</small></span>
          </div>
          <div class="ms__chat" data-chat>
            <div class="ms__thread">
              <span class="ms__chip">Hoy</span>
              <span class="ms__chip ms__chip--note">Vista previa: así llega tu pedido a WhatsApp</span>
              <div class="ms__bubble" data-bubble></div>
            </div>
          </div>
          <!-- The order-wide note is typed where a message is typed. -->
          <form class="ms__composer" data-composer>
            <textarea class="ms__compose" data-note rows="1" maxlength="500" enterkeyhint="send" placeholder="Nota para todo el pedido" aria-label="Nota para todo el pedido (Enter envía, Shift+Enter nueva línea)"></textarea>
            <button type="submit" class="ms__compose-send" aria-label="Enviar pedido por WhatsApp">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 21 12 3.4 3.6l-.01 6.53L15 12 3.39 13.87z"/></svg>
            </button>
          </form>
        </div>
        {/* Always offered: with no codes in the Sheet yet, any code just reads as not found. */}
        {(
          <div class="ms__promo" data-promo>
            {christmasCode && (
              <span data-season>
                <button type="button" class="ms__promo-suggest" data-promo-suggest={christmasCode}>
                  <span aria-hidden="true">🎄</span> Aplicar <strong>{christmasCode}</strong> de Navidad
                </button>
              </span>
            )}
            <button type="button" class="ms__promo-open" data-promo-open aria-expanded="false" aria-controls="ms-promo-form">¿Tienes un código de descuento?</button>
            <form class="ms__promo-form" id="ms-promo-form" data-promo-form hidden>
              <input class="ms__promo-input" data-promo-input maxlength="40" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Código" aria-label="Código de descuento" />
              <button type="submit" class="ms__promo-apply">Aplicar</button>
            </form>
            <div class="ms__promo-chip" data-promo-chip hidden>
              <span class="ms__promo-tag" aria-hidden="true">%</span>
              <span><strong data-promo-code></strong><small data-promo-saves></small></span>
              <button type="button" class="ms__promo-remove" data-promo-remove aria-label="Quitar código de descuento">×</button>
            </div>
            <p class="ms__promo-msg" data-promo-msg role="status"></p>
          </div>
        )}
        <div class="ms__dock">
          <div class="ms__total"><span class="ms__total-label">Total <s class="ms__was" data-was hidden></s></span><strong class="ms__num" data-total></strong></div>
          <button type="button" class="ms__send" data-send>
            <Icon name="simple-icons:whatsapp" class="w-4 h-4" />
            <span>Enviar <span class="ms__long">este </span>mensaje</span>
            <span class="ms__send-arrow" aria-hidden="true"><Icon name="lucide:arrow-right" class="w-4 h-4" /></span>
          </button>
          <p class="ms__caption">Se abre WhatsApp con este texto listo.</p>
        </div>
      </aside>
    </div>

    <section class="ms__state" data-empty hidden>
      <span class="ms__eyebrow">Tu pedido</span>
      <h1 class="ms__title">Tu carrito está vacío</h1>
      <p class="ms__lead">Elige una pieza del catálogo y la personalizamos para ti.</p>
      <a href="/catalogo" class="ms__send ms__send--auto"><span>Ver catálogo</span><span class="ms__send-arrow" aria-hidden="true"><Icon name="lucide:arrow-right" class="w-4 h-4" /></span></a>
    </section>

    <section class="ms__state" data-sent hidden>
      <span class="ms__sent-mark" aria-hidden="true"><Icon name="lucide:check" class="w-6 h-6" /></span>
      <h1 class="ms__title">¡Listo! Te abrimos WhatsApp con tu pedido</h1>
      <p class="ms__lead">Envía el mensaje y te escribimos para confirmar los detalles. ¿No se abrió? <a href="#" data-reopen target="_blank" rel="noopener">Ábrelo aquí</a>.</p>
      <a href="/catalogo" class="ms__more">Volver al catálogo</a>
    </section>
  </main>
</BaseLayout>

<script>
  import { mountCartView } from '../scripts/cart-view';

  // Re-mounted per visit: the router swaps the page in.
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('cart-page');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = '1';
    const view = mountCartView(root);
    document.addEventListener('astro:before-swap', view.destroy, { once: true });
  });
</script>

<style is:global>
  /* Global (ms-prefixed): the list and the message are rendered from script. */
  .ms {
    --line: color-mix(in oklab, var(--color-foreground) 12%, transparent);
    --fill: color-mix(in oklab, var(--color-foreground) 6%, transparent);
    --ink-3: color-mix(in oklab, var(--color-foreground) 38%, transparent);
    max-width: 76rem; margin: 0 auto; padding: 112px 24px 96px;
  }
  .ms [hidden] { display: none !important; }
  .ms__grid { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .ms__grid > * { min-width: 0; } /* long single-line notes ellipsize instead of widening the page */

  .ms__eyebrow { font: 500 11px/1 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-muted); }
  .ms__title { margin-top: 12px; font: 700 clamp(2.5rem, 5.6vw, 4.25rem)/0.95 var(--font-display); letter-spacing: -0.04em; text-wrap: balance; }
  .ms__lead { margin-top: 16px; max-width: 46ch; color: var(--color-muted); }
  .ms__lead a { color: var(--color-foreground); text-decoration: underline; text-underline-offset: 3px; }
  .ms__meta { display: flex; justify-content: space-between; gap: 16px; margin: 32px 0 12px; font: 500 11px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-muted); }

  /* Pieces: full strength; quantity and Quitar always at hand; the name opens its details. */
  .ms__list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .ms__item { border-bottom: 1px solid var(--line); }
  .ms__row { display: grid; grid-template-columns: 64px 1fr auto; align-items: center; column-gap: 16px; row-gap: 12px; padding: 16px 0; }
  .ms__img { width: 64px; height: 64px; border-radius: 14px; object-fit: cover; background: var(--color-surface); grid-row: span 2; align-self: start; }
  .ms__pick { display: grid; gap: 4px; text-align: left; cursor: pointer; border-radius: 6px; min-width: 0; }
  .ms__pick:focus-visible { outline: 2px solid var(--lilac); outline-offset: 4px; }
  .ms__name { font: 600 17px/1.2 var(--font-display); letter-spacing: -0.01em; }
  .ms__pick:hover .ms__name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .ms__item.is-open .ms__name::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 999px; background: var(--lilac); vertical-align: 0.15em; }
  .ms__sub { font-size: 13px; color: var(--color-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ms__sub em { font-style: normal; color: var(--color-foreground); text-decoration: underline dotted; text-underline-offset: 3px; }
  .ms__price { font-weight: 600; align-self: start; }
  .ms__ctrl { grid-column: 2 / -1; display: flex; align-items: center; justify-content: space-between; gap: 16px; }

  .ms__edit { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 240ms cubic-bezier(0.5, 0, 0.75, 0); }
  .ms__item.is-open .ms__edit { grid-template-rows: 1fr; transition: grid-template-rows 520ms cubic-bezier(0.16, 1, 0.3, 1); }
  .ms__edit-in { min-height: 0; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding-left: 80px; }
  .ms__edit-in > * { opacity: 0; translate: 0 8px; transition: opacity 140ms, translate 140ms; }
  .ms__item.is-open .ms__edit-in > * { opacity: 1; translate: 0 0; transition: opacity 400ms cubic-bezier(0.22, 1, 0.36, 1), translate 520ms cubic-bezier(0.16, 1, 0.3, 1); }
  .ms__item.is-open .ms__edit-in > :nth-child(n + 2) { transition-delay: 60ms; }
  .ms__item.is-open .ms__edit-in > :nth-child(n + 4) { transition-delay: 120ms; }
  .ms__edit-in > :first-child { margin-top: 4px; }
  .ms__edit-in > :last-child { margin-bottom: 20px; }
  .ms__f { display: grid; gap: 6px; align-content: start; }
  .ms__f--wide { grid-column: 1 / -1; }
  .ms__label { font: 500 10.5px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-muted); }
  .ms__input {
    width: 100%; min-height: 44px; padding: 10px 12px; border-radius: 12px; border: 1px solid transparent;
    background: var(--fill); color: var(--color-foreground); font-size: 15px; transition: border-color 200ms;
  }
  .ms__input::placeholder { color: var(--ink-3); }
  .ms__input:focus-visible { outline: none; border-color: var(--lilac); }
  :root[data-theme='dark'] .ms__input { color-scheme: dark; }
  .ms__step { display: inline-flex; align-items: center; border-radius: 12px; background: var(--fill); }
  .ms__step button { width: 44px; height: 44px; border-radius: 12px; font-size: 18px; color: var(--color-muted); transition: color 160ms, scale 140ms; }
  .ms__step button:hover { color: var(--color-foreground); }
  .ms__step button:active { scale: 0.88; }
  .ms__step span { min-width: 20px; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }
  .ms__chk { display: flex; align-items: center; gap: 12px; min-height: 44px; font-size: 14px; cursor: pointer; align-self: end; }
  .ms__chk input { width: 18px; height: 18px; accent-color: var(--lilac); }
  .ms__void { min-height: 44px; padding: 0 4px; font-size: 13px; color: var(--color-muted); text-decoration: underline; text-underline-offset: 4px; transition: color 160ms; }
  .ms__void:hover { color: #e0607e; }
  .ms__more { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; font-size: 13px; color: var(--color-muted); text-decoration: underline; text-underline-offset: 4px; }
  .ms__more:hover { color: var(--color-foreground); }

  /* The phone: a WhatsApp-like chat in the app's own palette, light or dark with the site. */
  .ms__preview { position: sticky; top: 96px; display: grid; gap: 16px; }
  .ms__phone {
    --wa-bg: #0b141a; --wa-head: #1f2c33; --wa-ink: #e9edef; --wa-ink-2: rgb(233 237 239 / 0.6); --wa-dots: rgb(255 255 255 / 0.035);
    --wa-chip: #182229; --wa-chip-ink: rgb(233 237 239 / 0.7); --wa-note-bg: #182229; --wa-note-ink: #e3c48a;
    --wa-out: #005c4b; --wa-input: #1f2c33; --wa-line: rgb(255 255 255 / 0.08);
    --wa-hl: rgb(217 168 217 / 0.2); --wa-hl-strong: rgb(217 168 217 / 0.42); --wa-hover: rgb(255 255 255 / 0.1);
    --wa-scroll: rgb(255 255 255 / 0.16); --wa-scroll-hover: rgb(255 255 255 / 0.3);
    display: flex; flex-direction: column; height: min(560px, 100svh - 300px); min-height: 380px; border-radius: 32px; overflow: hidden;
    background: var(--wa-bg); border: 1px solid var(--wa-line); color: var(--wa-ink);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06), 0 30px 60px -30px rgb(0 0 0 / 0.45);
  }
  :root[data-theme='light'] .ms__phone {
    --wa-bg: #efeae2; --wa-head: #f0f2f5; --wa-ink: #111b21; --wa-ink-2: #667781; --wa-dots: rgb(0 0 0 / 0.05);
    --wa-chip: #ffffff; --wa-chip-ink: #54656f; --wa-note-bg: #ffeecd; --wa-note-ink: #54656f;
    --wa-out: #d9fdd3; --wa-input: #ffffff; --wa-line: rgb(0 0 0 / 0.08);
    --wa-hl: rgb(163 90 168 / 0.16); --wa-hl-strong: rgb(163 90 168 / 0.34); --wa-hover: rgb(0 0 0 / 0.07);
    --wa-scroll: rgb(0 0 0 / 0.16); --wa-scroll-hover: rgb(0 0 0 / 0.3);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06), 0 30px 60px -30px rgb(60 40 20 / 0.3);
  }
  .ms__phone-top { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--wa-head); }
  .ms__phone-top strong { display: block; font-size: 15px; font-weight: 600; }
  .ms__phone-top small { display: block; font-size: 12px; color: var(--wa-ink-2); }
  .ms__avatar { width: 38px; height: 38px; border-radius: 999px; object-fit: cover; background: var(--color-brand-black); }
  .ms__phone-top, .ms__composer { flex: none; } /* only the chat area gives up height */
  /* Chat wallpaper: a faint dot grid, like the app's doodle pattern without copying it. */
  .ms__chat {
    flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 16px 14px; display: flex; flex-direction: column;
    background: radial-gradient(var(--wa-dots) 1px, transparent 1.4px) 0 0 / 18px 18px, var(--wa-bg);
  }
  /* Discreet scrollbars inside the phone: thin, translucent thumb, no track. */
  .ms__chat, .ms__compose { scrollbar-width: thin; scrollbar-color: var(--wa-scroll) transparent; }
  .ms__chat::-webkit-scrollbar, .ms__compose::-webkit-scrollbar { width: 6px; }
  .ms__chat::-webkit-scrollbar-track, .ms__compose::-webkit-scrollbar-track { background: transparent; }
  .ms__chat::-webkit-scrollbar-thumb, .ms__compose::-webkit-scrollbar-thumb { border-radius: 999px; background: var(--wa-scroll); }
  .ms__chat:hover::-webkit-scrollbar-thumb, .ms__compose:hover::-webkit-scrollbar-thumb { background: var(--wa-scroll-hover); }
  .ms__thread { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }
  .ms__chip { align-self: center; padding: 5px 10px; border-radius: 8px; background: var(--wa-chip); font-size: 12px; color: var(--wa-chip-ink); text-align: center; box-shadow: 0 1px 0.5px rgb(0 0 0 / 0.08); }
  .ms__chip--note { max-width: 86%; background: var(--wa-note-bg); color: var(--wa-note-ink); margin-bottom: 6px; }
  .ms__bubble {
    align-self: flex-end; max-width: 92%; padding: 8px 10px 22px 10px; border-radius: 12px 0 12px 12px; margin-right: 8px;
    background: var(--wa-out); font-size: 13.5px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; position: relative;
    box-shadow: 0 1px 0.5px rgb(0 0 0 / 0.13);
    /* Lets the height animate (content can't spill past the bottom) while the tail still shows on the right. */
    clip-path: inset(0 -10px 0 0);
  }
  .ms__bubble::before { content: ''; position: absolute; top: 0; right: -8px; width: 8px; height: 13px; background: inherit; clip-path: polygon(0 0, 100% 0, 0 100%); }
  .ms__bubble strong { font-weight: 700; }
  .ms__meta-time { position: absolute; right: 8px; bottom: 4px; display: inline-flex; align-items: center; gap: 3px; font-size: 11px; color: var(--wa-ink-2); }
  .ms__ticks { color: var(--wa-ink-2); transition: color 300ms; }
  .ms__bubble.is-read .ms__ticks { color: #53bdeb; }
  .ms__composer { display: flex; align-items: flex-end; gap: 8px; padding: 8px 10px 10px; background: var(--wa-bg); }
  .ms__compose {
    /* Grows with the note, line by line, up to ~5 lines; then it scrolls inside. */
    flex: 1; min-width: 0; min-height: 44px; max-height: 120px; padding: 11px 16px; border: 1px solid transparent; border-radius: 22px;
    background: var(--wa-input); color: var(--wa-ink); font: inherit; font-size: 14px; line-height: 1.4;
    resize: none; overflow-y: auto; field-sizing: content; transition: border-color 200ms;
  }
  .ms__compose::placeholder { color: var(--wa-ink-2); }
  .ms__compose:focus-visible { outline: none; border-color: rgb(163 90 168 / 0.6); }
  .ms__compose-send {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px;
    background: #d9a8d9; color: #0d0d0c; transition: scale 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ms__compose-send:hover { scale: 1.05; }
  .ms__compose-send:active { scale: 0.92; }
  .ms__compose-send:focus-visible { outline: 2px solid #a35aa8; outline-offset: 3px; }
  /* A piece's lines. Inline (not block) so the message's own line breaks stay exactly as sent. */
  .ms__blk {
    padding: 1px 4px; margin: 0 -4px; border-radius: 4px; cursor: pointer;
    -webkit-box-decoration-break: clone; box-decoration-break: clone; transition: background-color 300ms;
  }
  .ms__blk.is-hover { background: var(--wa-hover); }
  .ms__blk.is-active { background: var(--wa-hl); }
  .ms__blk.is-active.is-hover { background: var(--wa-hl-strong); }
  .ms__blk.is-flash { background: var(--wa-hl-strong); transition: none; }
  /* A line that just appeared settles in. */
  .ms__new { animation: ms-line 420ms cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes ms-line { from { opacity: 0; filter: blur(4px); } }
  /* The list side of the hover link. */
  .ms__item { transition: background-color 200ms; }
  .ms__item.is-hover { background: var(--fill); }

  .ms__dock { display: grid; gap: 12px; }

  /* Discount code: a quiet link that opens into a field; once applied, a chip with what it saves. */
  .ms__promo { display: grid; gap: 8px; }
  .ms__promo-suggest {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px;
    border: 1px dashed color-mix(in oklab, var(--lilac) 70%, transparent); background: color-mix(in oklab, var(--lilac) 10%, transparent);
    font-size: 14px; color: var(--color-foreground); transition: background-color 200ms, scale 140ms;
  }
  .ms__promo-suggest strong { font: 600 13px/1 var(--font-mono); letter-spacing: 0.08em; }
  .ms__promo-suggest:hover { background: color-mix(in oklab, var(--lilac) 18%, transparent); }
  .ms__promo-suggest:active { scale: 0.97; }
  .ms__promo-open { justify-self: start; min-height: 36px; font-size: 13px; color: var(--color-muted); text-decoration: underline dotted; text-underline-offset: 4px; }
  .ms__promo-open:hover { color: var(--color-foreground); }
  .ms__promo-form { display: flex; gap: 8px; }
  .ms__promo-input {
    flex: 1; min-width: 0; min-height: 44px; padding: 0 14px; border-radius: 12px; border: 1px solid transparent;
    background: var(--fill); color: var(--color-foreground); font: 600 14px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  }
  .ms__promo-input::placeholder { font-weight: 400; letter-spacing: 0.04em; color: var(--ink-3); }
  .ms__promo-input:focus-visible { outline: none; border-color: var(--lilac); }
  .ms__promo-input[aria-invalid='true'] { border-color: #e0607e; }
  .ms__promo-apply { min-height: 44px; padding: 0 16px; border-radius: 12px; background: var(--color-foreground); color: var(--color-background); font-weight: 600; font-size: 14px; transition: opacity 200ms, scale 140ms; }
  .ms__promo-apply:disabled { opacity: 0.5; }
  .ms__promo-apply:active { scale: 0.96; }
  .ms__promo-chip { display: flex; align-items: center; gap: 12px; padding: 8px 8px 8px 10px; border-radius: 14px; border: 1px dashed color-mix(in oklab, var(--lilac) 60%, transparent); background: color-mix(in oklab, var(--lilac) 10%, transparent); }
  .ms__promo-chip > span:nth-child(2) { flex: 1; display: grid; gap: 2px; min-width: 0; }
  .ms__promo-chip strong { font: 600 13px/1.2 var(--font-mono); letter-spacing: 0.08em; }
  .ms__promo-chip small { font-size: 12px; color: var(--color-muted); }
  .ms__promo-tag { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 999px; background: var(--lilac); color: var(--color-brand-black); font-weight: 700; }
  .ms__promo-remove { width: 36px; height: 36px; border-radius: 999px; font-size: 20px; color: var(--color-muted); transition: background-color 160ms, color 160ms; }
  .ms__promo-remove:hover { background: var(--fill); color: var(--color-foreground); }
  .ms__promo-msg { min-height: 1.2em; font-size: 12.5px; color: var(--color-muted); }
  .ms__promo-msg.is-error { color: #e0607e; }
  .ms__promo-msg:empty { display: none; }
  /* The old total, struck through: the line draws across once the discount lands. */
  .ms__total-label { display: inline-flex; align-items: baseline; gap: 10px; }
  .ms__was { position: relative; text-decoration: none; font-size: 14px; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--color-muted); }
