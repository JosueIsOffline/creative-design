---
// Creative Design's hero: the brand name (with the cursor standing in for
// the "a" of "Creative"), the signature, lead copy and CTAs. The headline
// rises into focus on load (blurred -> sharp), inspired by hipuku.dev's
// wordmark reveal. No scroll-pinned board/cards any more — removed per
// request; HeroStory.astro (an earlier scroll-storytelling attempt) stays
// in the codebase, on hold.
import { Icon } from 'astro-icon/components';

const whatsapp = import.meta.env.WHATSAPP_NUMBER;
const waMessage = encodeURIComponent('Hola! Quiero más información sobre Creative Design.');

const h = {
  lead: 'Diseño gráfico y sublimación: artículos personalizados y piezas de diseño hechas con amor.',
  button: 'Ver catálogo',
  href: '/catalogo',
  button2: 'Escribinos',
  href2: `https://wa.me/${whatsapp}?text=${waMessage}`,
};

// Callout tags wired to letters of the headline, like hipuku.dev's
// WORK / WRITING / … labels. ch: which letter (index into the [data-ch]
// list: C r e ▸ t i v e · D e s i g n) the wire starts from; x: tag centre
// as a fraction of the headline width; y: tag centre in em of the
// headline font size (negative = above it).
// The tags are the story's chapters: each jumps to its chapter in the
// scroll story further down (ProcessStory.astro).
const callouts = [
  { label: 'Diseño', href: '#cap-diseno', ch: 0, x: 0.12, y: -0.62 },
  { label: 'Sublimación', href: '#cap-sublimacion', ch: 5, x: 0.36, y: -1.05 },
  { label: 'Empaquetado', href: '#cap-empaquetado', ch: 9, x: 0.62, y: -0.78 },
  { label: 'Entrega', href: '#cap-entrega', ch: 14, x: 0.88, y: -0.5 },
];
---
<section class="hero" data-hero>
  <div class="hero__head">
    <h1 class="hero__title display">
      <span class="sr-only">Creative Design</span>
      <span aria-hidden="true">
        {'Cre'.split('').map((c) => <span class="hero__ch" data-ch>{c}</span>)}<span class="hero__ch" data-ch><svg viewBox="-8 0 32 32" class="hero__cursor" fill="none">
              <g transform="rotate(-1 12.5 20.5)">
                <g transform="translate(4,4) rotate(15)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="currentColor" /></g>
                <g transform="translate(-1,6) rotate(-40)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#f7d842" /></g>
                <g transform="translate(-4,10) rotate(-80)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#e85fa0" /></g>
                <g transform="translate(-3,15) rotate(-115)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#5ec8e8" /></g>
                <path d="M4 12l7.07 17 2.51-7.39L21 19.07 4 12z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
              </g>
            </svg></span>{'tive Design'.split('').map((c) => <span class="hero__ch" data-ch>{c}</span>)}
      </span>
    </h1>
    <nav class="hero__callouts" aria-label="Secciones">
      <svg class="hero__wires" data-wires aria-hidden="true"></svg>
      {callouts.map((c) => (
        <a class="hero__tag" href={c.href} data-callout data-ch-index={c.ch} data-x={c.x} data-y={c.y}>{c.label}</a>
      ))}
    </nav>
    <div class="hero__signature" data-sig>
      <span class="hero__signature-rule" aria-hidden="true"></span>
      <span class="hero__signature-text">By Ailyn Japa</span>
      <span class="hero__signature-rule hero__signature-rule--end" aria-hidden="true"></span>
    </div>
  </div>
  <div class="hero__foot" data-in>
    <p class="hero__lead">{h.lead}</p>
    <div class="hero__cta">
      <a class="btn btn--solid" href={h.href}>{h.button}<Icon name="lucide:arrow-right" width="16" height="16" class="icon icon--after" /></a>
      <a class="btn" href={h.href2} target="_blank" rel="noopener">{h.button2}</a>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'motion';

  const ease = { outExpo: [0.16, 1, 0.3, 1] as const };

  for (const root of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    if (root.dataset.heroMounted) continue;
    root.dataset.heroMounted = 'true';

    const chars = root.querySelectorAll<HTMLElement>('[data-ch]');
    const sig = root.querySelector<HTMLElement>('[data-sig]');
    const foot = root.querySelectorAll<HTMLElement>('[data-in]');
    const wires = root.querySelector<SVGSVGElement>('[data-wires]');
    const tags = [...root.querySelectorAll<HTMLElement>('[data-callout]')];
    const title = root.querySelector<HTMLElement>('.hero__title');
    const head = root.querySelector<HTMLElement>('.hero__head');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Wires: from a dot on the letter, straight up to the tag's height, a
    // rounded turn, then across to the tag's nearest edge. Positions come
    // from layout (offsetLeft/Top relative to .hero__head), so the letters'
    // entrance transforms don't throw them off. Rebuilt on resize.
    const NS = 'http://www.w3.org/2000/svg';
    let shown = reduce;
    const draw = () => {
      if (!wires || !title || !head || !head.offsetWidth || getComputedStyle(wires).display === 'none') return [];
      const W = head.offsetWidth, fs = parseFloat(getComputedStyle(title).fontSize);
      wires.replaceChildren();
      return tags.map((tag) => {
        const ch = chars[Number(tag.dataset.chIndex)];
        const dx = ch.offsetLeft + ch.offsetWidth / 2, dy = ch.offsetTop + ch.offsetHeight * 0.42;
        const tx = Number(tag.dataset.x) * W, ty = Number(tag.dataset.y) * fs;
        tag.style.left = `${tx}px`; tag.style.top = `${ty}px`;
        const tw = tag.offsetWidth, th = tag.offsetHeight;
        let d: string;
        if (Math.abs(tx - dx) < tw / 2 - 6) {
          d = `M ${dx} ${dy} V ${ty + th / 2}`;
        } else {
          const dir = tx > dx ? 1 : -1, edge = tx - dir * (tw / 2), r = Math.min(12, Math.abs(edge - dx));
          d = `M ${dx} ${dy} V ${ty + r} Q ${dx} ${ty} ${dx + dir * r} ${ty} H ${edge}`;
        }
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', d); path.setAttribute('pathLength', '1');
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('cx', String(dx)); dot.setAttribute('cy', String(dy)); dot.setAttribute('r', '4.5');
        if (!shown) { path.style.strokeDashoffset = '1'; dot.style.opacity = '0'; }
        wires.append(path, dot);
        return { path, dot, tag };
      });
    };
    let parts = draw();
    addEventListener('resize', () => { parts = draw(); });
    document.fonts?.ready.then(() => { parts = draw(); });

    if (reduce) continue;

    // hipuku.dev's wordmark reveal: each letter starts in place as a big soft
    // blob of colour and pulls into focus, one after another — no slide.
    // On a first visit the page's intro overlay (index.astro) covers the hero
    // for ~1.1s — start after it, or the reveal plays unseen behind it.
    let seen = true;
    try { seen = sessionStorage.getItem('intro-seen') === '1'; } catch {}
    const start = !seen && document.querySelector('[data-intro]') ? 1.15 : 0.1;
    const n = chars.length;
    animate(
      chars,
      { opacity: [0, 1], filter: ['blur(40px)', 'blur(0px)'], scale: [1.2, 1] },
      { duration: 1.3, ease: ease.outExpo, delay: stagger(0.06, { startDelay: start }) }
    );
    const after = start + n * 0.06 + 0.3;
    if (sig) animate(sig, { opacity: [0, 1], filter: ['blur(16px)', 'blur(0px)'] }, { duration: 1, ease: ease.outExpo, delay: after });
    animate(foot, { opacity: [0, 1], y: [24, 0], filter: ['blur(8px)', 'blur(0px)'] }, { duration: 1, ease: ease.outExpo, delay: after + 0.2 });

    // Then the wires: dot pops on the letter, the line draws out to its tag,
    // the tag blurs in — one callout after another.
    setTimeout(() => {
      shown = true;
      parts.forEach(({ path, dot, tag }, i) => {
        const t = i * 0.18;
        animate(dot, { opacity: [0, 1], scale: [0, 1] }, { duration: 0.4, ease: ease.outExpo, delay: t });
        animate(path, { strokeDashoffset: [1, 0] }, { duration: 0.7, ease: [0.65, 0, 0.35, 1], delay: t + 0.1 });
        animate(tag, { opacity: [0, 1], filter: ['blur(8px)', 'blur(0px)'] }, { duration: 0.6, ease: ease.outExpo, delay: t + 0.55 });
      });
    }, (after + 0.4) * 1000);
  }
</script>

<style>
  /* Short local token names for the CSS below, pointed at our own brand
     colors (src/styles/global.css) rather than spelling out
     var(--background) etc. everywhere. These resolve through the theme
     toggle too, since they reference our real :root properties. */
  .hero {
    --bg: var(--background); --fg: var(--foreground);
    --accent: var(--color-brand-lilac); --accent-ink: var(--color-brand-black);
    --surface: color-mix(in oklab, var(--fg) 5%, transparent);
    --line: color-mix(in oklab, var(--fg) 14%, transparent);
    --display: var(--font-display);
    --text: var(--font-display);
    --r-sm: 999px;
    --dur-1: 400ms;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --fs-hero: clamp(3.2rem, 8.4vw, 8.5rem);
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 48px; padding: 0 22px; border: 1px solid var(--line); border-radius: var(--r-sm);
    background: var(--surface); color: var(--fg); font: 500 15px/1 var(--text); text-decoration: none; white-space: nowrap;
    transition: background-color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out), scale 200ms var(--ease-out);
  }
  .btn--solid { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .btn:active { scale: 0.97; }
  .btn .icon { transition: translate var(--dur-1) var(--ease-out); }
  @media (hover: hover) {
    .btn:hover { background: color-mix(in oklab, var(--fg) 12%, transparent); border-color: color-mix(in oklab, var(--fg) 30%, transparent); }
    .btn--solid:hover { background: color-mix(in oklab, var(--accent) 86%, var(--fg)); border-color: transparent; }
    .btn:hover .icon--after { translate: 3px 0; }
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Our header floats fixed (a pill, out of document flow) — no header-
     height offset needed here, just centre the content in the viewport
     like the original Hero.astro did. */
  .hero {
    position: relative; min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(28px, 4vw, 44px);
    padding: clamp(20px, 3vw, 44px); text-align: center;
    background: var(--bg); color: var(--fg);
  }
  .hero__title { --size: var(--fs-hero); font-family: 'Parkinsans', var(--display); font-weight: 700; font-size: var(--size); line-height: 0.95; letter-spacing: -0.045em; color: var(--accent); }
  .hero__ch { display: inline-block; white-space: pre; transform-origin: 50% 60%; }

  /* Callouts: room reserved above the headline so the centred layout
     accounts for the tags, which hang off negative y. */
  .hero__head { position: relative; margin-top: clamp(80px, 10vw, 150px); }
  .hero__callouts { position: absolute; inset: 0; pointer-events: none; }
  .hero__wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hero__wires :global(path) { fill: none; stroke: color-mix(in oklab, var(--fg) 45%, transparent); stroke-width: 1.25; stroke-dasharray: 1; }
  .hero__wires :global(circle) { fill: var(--fg); transform-box: fill-box; transform-origin: center; }
  .hero__tag {
    position: absolute; translate: -50% -50%; pointer-events: auto; white-space: nowrap;
    padding: 6px 14px; border: 1px solid color-mix(in oklab, var(--fg) 40%, transparent); border-radius: 999px;
    background: var(--bg); color: color-mix(in oklab, var(--fg) 85%, transparent); text-decoration: none;
    font: 600 11px/1 'Parkinsans', var(--display); letter-spacing: 0.14em; text-transform: uppercase;
    transition: border-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .hero__tag:hover, .hero__tag:focus-visible { border-color: var(--accent); color: var(--accent); }
  .hero__cursor { display: inline-block; height: 0.8em; width: auto; vertical-align: baseline; margin-inline: -0.2em; color: var(--fg); }

  /* By Ailyn Japa */
  .hero__signature { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 18px; }
  .hero__signature-rule { height: 1px; width: clamp(28px, 3.5vw, 52px); background: linear-gradient(90deg, transparent, var(--fg)); }
  .hero__signature-rule--end { background: linear-gradient(270deg, transparent, var(--fg)); }
  .hero__signature-text { font-family: var(--font-script); font-size: clamp(1.3rem, 2.4vw, 1.9rem); color: var(--fg); }

  .hero__foot { display: grid; justify-items: center; gap: 22px; max-width: 34rem; }
  .hero__lead { color: color-mix(in oklab, var(--fg) 82%, transparent); font-size: clamp(16px, 1.3vw, 19px); line-height: 1.45; max-width: 40ch; }
  .hero__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }

  /* Hidden before the entrance runs — only with JS on and motion allowed,
     so no-JS / reduced-motion visitors just see everything. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero [data-ch], :global(.js) .hero [data-sig], :global(.js) .hero [data-in], :global(.js) .hero [data-callout] { opacity: 0; }
  }

  @media (max-width: 809px) {
    .hero { min-height: 100svh; padding: 18px 18px 48px; }
    .hero__title { --size: clamp(2.6rem, 12.5vw, 4rem); }
    /* Too cramped for wires at phone width — the header nav covers these links. */
    .hero__callouts { display: none; }
    .hero__head { margin-top: 0; }
  }
</style>
