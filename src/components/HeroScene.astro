---
// Creative Design's hero: the brand name (with the cursor standing in for
// the "a" of "Creative"), the signature, lead copy and CTAs. The headline
// rises into focus on load (blurred -> sharp), inspired by hipuku.dev's
// wordmark reveal.
//
// Then the hero *is* the story (after Halo's deck): it stays pinned, its
// surface crops down into a card while the headline dissolves, and that
// card is the first of six — one per service tag. Each next card rises
// over the last, which sinks back into the stack; inside each, the
// service's iso scene assembles part by part (Sublimación last, with the
// heat press). On desktop the tags slide into a column as the chapter
// index. Without JS or with reduced motion: just the hero.
import { Icon } from 'astro-icon/components';
import pressSvg from '../../tools/heat-press-figure/figure.svg?raw';
import identidadSvg from '../../tools/services-figure/identidad.svg?raw';
import flyersSvg from '../../tools/services-figure/flyers.svg?raw';
import redesSvg from '../../tools/services-figure/redes.svg?raw';
import papeleriaSvg from '../../tools/services-figure/papeleria.svg?raw';
import personalizacionSvg from '../../tools/services-figure/personalizacion.svg?raw';

const whatsapp = import.meta.env.WHATSAPP_NUMBER;
const waMessage = encodeURIComponent('Hola! Quiero más información sobre Creative Design.');

const h = {
  lead: 'Diseño gráfico y sublimación: artículos personalizados y piezas de diseño hechas con amor.',
  button: 'Ver catálogo',
  href: '/catalogo',
  button2: 'Escribinos',
  href2: `https://wa.me/${whatsapp}?text=${waMessage}`,
};

// Callout tags wired to letters of the headline, like hipuku.dev's
// WORK / WRITING / … labels. ch: which letter (index into the [data-ch]
// list: C r e ▸ t i v e · D e s i g n) the wire starts from; x: tag centre
// as a fraction of the headline width; y: tag centre in em of the
// headline font size (negative = above it).
// The tags are the services — each links into the catalog.
// Each tag is also a chapter of the scroll story: its scene and one line.
const callouts = [
  { label: 'Identidad visual', href: '/catalogo/servicios-de-diseno', ch: 0, x: 0.08, y: -0.6, svg: identidadSvg, line: 'Logo, paleta y tipografía: la cara de tu marca.' },
  { label: 'Flyers', href: '/catalogo/servicios-de-diseno', ch: 5, x: 0.3, y: -1.12, svg: flyersSvg, line: 'Piezas que se ven, se leen y venden.' },
  { label: 'Papelería', href: '/catalogo/servicios-de-diseno/papeleria-personalizada', ch: 7, x: 0.49, y: -0.72, svg: papeleriaSvg, line: 'Hojas, sobres y tarjetas con tu sello.' },
  { label: 'Redes sociales', href: '/catalogo/servicios-de-diseno', ch: 12, x: 0.79, y: -0.62, svg: redesSvg, line: 'Contenido que frena el scroll: se mira, se comenta y se comparte.' },
  { label: 'Personalización', href: '/catalogo', ch: 9, x: 0.62, y: -1.12, svg: personalizacionSvg, line: 'Tu diseño en tazas, fundas, llaveros y más.' },
  { label: 'Sublimación', href: '/catalogo', ch: 14, x: 0.95, y: -1.12, svg: pressSvg, line: 'Calor y presión: la tinta pasa a la pieza.' },
];

---
<section class="hero" data-hero>
  <div class="hero__pin">
  <div class="hero__skin" data-skin></div>
  <div class="hero__deck" data-deck aria-hidden="true">
    {callouts.map((c, i) => (
      <article class="hero__card" data-card>
        <header class="hero__card-head"><span class="hero__card-n">0{i + 1}</span>{c.label}</header>
        <div class="hero__scene anatomy-figure iso" data-theme="dark" data-scene style={i < callouts.length - 1 ? '--zoom: 1.3' : undefined}><Fragment set:html={c.svg} /></div>
        <p class="hero__card-line">{c.line}</p>
      </article>
    ))}
  </div>
  <div class="hero__panel">
  <div class="hero__copy">
  <div class="hero__head">
    <h1 class="hero__title display" data-out>
      <span class="sr-only">Creative Design</span>
      <span aria-hidden="true">
        {'Cre'.split('').map((c) => <span class="hero__ch" data-ch>{c}</span>)}<span class="hero__ch" data-ch><svg viewBox="-8 0 32 32" class="hero__cursor" fill="none">
              <g transform="rotate(-1 12.5 20.5)">
                <g transform="translate(4,4) rotate(15)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="currentColor" /></g>
                <g transform="translate(-1,6) rotate(-40)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#f7d842" /></g>
                <g transform="translate(-4,10) rotate(-80)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#e85fa0" /></g>
                <g transform="translate(-3,15) rotate(-115)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#5ec8e8" /></g>
                <path d="M4 12l7.07 17 2.51-7.39L21 19.07 4 12z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
              </g>
            </svg></span>{'tive Design'.split('').map((c) => <span class="hero__ch" data-ch>{c}</span>)}
      </span>
    </h1>
    <nav class="hero__callouts" aria-label="Secciones">
      <svg class="hero__wires" data-wires aria-hidden="true"></svg>
      {callouts.map((c) => (
        <a class="hero__tag" href={c.href} data-callout data-ch-index={c.ch} data-x={c.x} data-y={c.y}>{c.label}</a>
      ))}
    </nav>
    <div data-out>
    <div class="hero__signature" data-sig>
      <span class="hero__signature-rule" aria-hidden="true"></span>
      <span class="hero__signature-text">By Ailyn Japa</span>
      <span class="hero__signature-rule hero__signature-rule--end" aria-hidden="true"></span>
    </div>
    </div>
  </div>
  <div data-out>
  <div class="hero__foot" data-in>
    <p class="hero__lead">{h.lead}</p>
    <div class="hero__cta">
      <a class="btn btn--solid" href={h.href}>{h.button}<Icon name="lucide:arrow-right" width="16" height="16" class="icon icon--after" /></a>
      <a class="btn" href={h.href2} target="_blank" rel="noopener">{h.button2}</a>
    </div>
  </div>
  </div>
  </div>
  </div>

  </div>
</section>

<script>
  import { animate, stagger, scroll } from 'motion';
  import press from '../../tools/heat-press-figure/figure-data.json';

  const ease = { outExpo: [0.16, 1, 0.3, 1] as const };

  // --- Scroll story helpers ---------------------------------------------
  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const inOut = (x: number) => (x < 0.5 ? 4 * x ** 3 : 1 - (-2 * x + 2) ** 3 / 2);
  const out = (x: number) => 1 - (1 - x) ** 3;
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;
  type V = [number, number, number];
  const lerp3 = (a: V, b: V, k: number): V => [mix(a[0], b[0], k), mix(a[1], b[1], k), mix(a[2], b[2], k)];

  // World offsets (≈ mm) → screen px. All the scenes share the press's
  // projection (services-figure/build.mjs fits them the same way).
  const { x: AX, y: AY, z: AZ } = press.AXES;
  const toScreen = ([x, y, z]: V) => [x * AX[0] + y * AY[0] + z * AZ[0], x * AX[1] + y * AY[1] + z * AZ[1]];
  const move = (el: Element | null, w: V, s = 1, c: [number, number] = [0, 0]) => {
    if (!el) return;
    const [dx, dy] = toScreen(w);
    const grow = s === 1 ? '' : ` translate(${c[0].toFixed(1)} ${c[1].toFixed(1)}) scale(${s.toFixed(3)}) translate(${(-c[0]).toFixed(1)} ${(-c[1]).toFixed(1)})`;
    el.setAttribute('transform', `translate(${dx.toFixed(2)} ${dy.toFixed(2)})${grow}`);
  };

  // Where each part of the four design scenes floats before it lands. The
  // flyers start as one stack in the middle and fan out.
  const FLOAT: Record<string, V> = {
    board: [0, 0, -60], guides: [0, 0, 60], mark: [-20, 30, 130], swatches: [60, -30, 90], type: [40, 50, 80], pencil: [-40, 60, 110],
    stack: [0, 0, -50], flyer0: [142, -20, 46], flyer1: [80, -48, 36], flyer2: [16, -74, 26],
    letter: [-40, -30, 90], envelope: [50, -50, 70], cards: [30, 60, 120], pen: [-50, 50, 100],
    phone: [0, 0, -50], post: [40, -40, 110], like: [0, 0, -40], comment: [0, 0, -20],
    tee: [0, 0, -50], case: [70, -40, 90], mug: [0, 0, 120], print: [0, 0, 70], keychain: [-30, 60, 110],
  };

  // The press (chapter 5): same beats as before, as shares of its chapter.
  const { OPEN_Z, CLOSED_Z } = press;
  const PEEL = press.PAPER_PEEL as V;
  const PRESS_FLOAT: Record<string, V> = {
    base: [0, 0, -70], posts: [-30, -60, 50], panel: [80, -40, 90], product: [0, 30, 70], paper: [0, 40, 150], head: [0, 0, OPEN_Z + 140],
  };
  const PRESS_REST: Record<string, V> = { base: [0, 0, 0], posts: [0, 0, 0], panel: [0, 0, 0], product: [0, 0, 0], paper: [0, 0, 0], head: [0, 0, OPEN_Z] };
  const PT = { assemble: [0.04, 0.34], close: [0.4, 0.48], open: [0.54, 0.62], peel: [0.6, 0.68], fade: [0.7, 0.8], rise: [0.72, 0.95] };

  // Shares of the pinned scroll: the hero dissolves, then one chapter per
  // tag (the press gets the longest), then the next section rises over the
  // still-pinned deck (its last 100svh: see .after-hero in global.css).
  const INTRO = 0.09;
  const END = 1 - 100 / (880 - 100);
  const WEIGHTS = [1, 1, 1, 1, 1, 1.7];
  const SPANS = (() => {
    const total = WEIGHTS.reduce((a, b) => a + b, 0);
    let at = INTRO;
    return WEIGHTS.map((w) => { const a = at; at += ((END - INTRO) * w) / total; return [a, at] as const; });
  })();

  // Astro's ClientRouter swaps pages without re-running module scripts, so
  // mount on every astro:page-load (each visit to the home brings a fresh
  // [data-hero]) and drop this page's window/scroll listeners before the
  // next swap — otherwise coming back left the callouts unpositioned,
  // piled up at the headline's corner.
  function mount() {
  const ac = new AbortController();
  document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    if (root.dataset.heroMounted) continue;
    root.dataset.heroMounted = 'true';

    const chars = root.querySelectorAll<HTMLElement>('[data-ch]');
    const sig = root.querySelector<HTMLElement>('[data-sig]');
    const foot = root.querySelectorAll<HTMLElement>('[data-in]');
    const wires = root.querySelector<SVGSVGElement>('[data-wires]');
    const tags = [...root.querySelectorAll<HTMLElement>('[data-callout]')];
    const title = root.querySelector<HTMLElement>('.hero__title');
    const head = root.querySelector<HTMLElement>('.hero__head');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Wires: from a dot on the letter, straight up to the tag's height, a
    // rounded turn, then across to the tag's nearest edge. Positions come
    // from layout (offsetLeft/Top relative to .hero__head), so the letters'
    // entrance transforms don't throw them off. Rebuilt on resize.
    const NS = 'http://www.w3.org/2000/svg';
    let shown = reduce;
    const draw = () => {
      if (!wires || !title || !head || !head.offsetWidth || getComputedStyle(wires).display === 'none') return [];
      const W = head.offsetWidth, fs = parseFloat(getComputedStyle(title).fontSize);
      wires.replaceChildren();
      return tags.map((tag) => {
        const ch = chars[Number(tag.dataset.chIndex)];
        const dx = ch.offsetLeft + ch.offsetWidth / 2, dy = ch.offsetTop + ch.offsetHeight * 0.42;
        const tx = Number(tag.dataset.x) * W, ty = Number(tag.dataset.y) * fs;
        tag.style.left = `${tx}px`; tag.style.top = `${ty}px`;
        const tw = tag.offsetWidth, th = tag.offsetHeight;
        let d: string;
        if (Math.abs(tx - dx) < tw / 2 - 6) {
          d = `M ${dx} ${dy} V ${ty + th / 2}`;
        } else {
          const dir = tx > dx ? 1 : -1, edge = tx - dir * (tw / 2), r = Math.min(12, Math.abs(edge - dx));
          d = `M ${dx} ${dy} V ${ty + r} Q ${dx} ${ty} ${dx + dir * r} ${ty} H ${edge}`;
        }
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', d); path.setAttribute('pathLength', '1');
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('cx', String(dx)); dot.setAttribute('cy', String(dy)); dot.setAttribute('r', '4.5');
        if (!shown) { path.style.strokeDashoffset = '1'; dot.style.opacity = '0'; }
        wires.append(path, dot);
        return { path, dot, tag };
      });
    };
    // Story mode: each tag's offset from its callout spot to its slot in a
    // left-hand column, measured at rest (pin and head move together, so
    // the offset holds while pinned).
    const pin = root.querySelector<HTMLElement>('.hero__pin')!;
    let slots: [number, number][] = [];
    const measure = () => {
      if (!head) return;
      const hr = head.getBoundingClientRect(), pr = pin.getBoundingClientRect();
      const gutter = Math.max(20, innerWidth * 0.04), gap = 46;
      slots = tags.map((tag, i) => {
        const cx = hr.left + parseFloat(tag.style.left || '0'), cy = hr.top + parseFloat(tag.style.top || '0');
        const x = pr.left + gutter + tag.offsetWidth / 2, y = pr.top + pr.height / 2 + (i - (tags.length - 1) / 2) * gap;
        return [x - cx, y - cy];
      });
    };
    let parts = draw();
    measure();
    let rerender = () => {};
    addEventListener('resize', () => { parts = draw(); measure(); rerender(); }, { signal: ac.signal });
    document.fonts?.ready.then(() => { parts = draw(); measure(); rerender(); });

    if (reduce) continue;

    // hipuku.dev's wordmark reveal: each letter starts in place as a big soft
    // blob of colour and pulls into focus, one after another — no slide.
    // On a first visit the page's intro overlay (index.astro) covers the hero
    // for ~1.1s — start after it, or the reveal plays unseen behind it.
    let seen = true;
    try { seen = sessionStorage.getItem('intro-seen') === '1'; } catch {}
    const start = !seen && document.querySelector('[data-intro]') ? 1.15 : 0.1;
    const n = chars.length;
    animate(
      chars,
      { opacity: [0, 1], filter: ['blur(40px)', 'blur(0px)'], scale: [1.2, 1] },
      { duration: 1.3, ease: ease.outExpo, delay: stagger(0.06, { startDelay: start }) }
    );
    const after = start + n * 0.06 + 0.3;
    if (sig) animate(sig, { opacity: [0, 1], filter: ['blur(16px)', 'blur(0px)'] }, { duration: 1, ease: ease.outExpo, delay: after });
    animate(foot, { opacity: [0, 1], y: [24, 0], filter: ['blur(8px)', 'blur(0px)'] }, { duration: 1, ease: ease.outExpo, delay: after + 0.2 });

    // Then the wires: dot pops on the letter, the line draws out to its tag,
    // the tag blurs in — one callout after another.
    setTimeout(() => {
      shown = true;
      parts.forEach(({ path, dot, tag }, i) => {
        const t = i * 0.18;
        animate(dot, { opacity: [0, 1], scale: [0, 1] }, { duration: 0.4, ease: ease.outExpo, delay: t });
        animate(path, { strokeDashoffset: [1, 0] }, { duration: 0.7, ease: [0.65, 0, 0.35, 1], delay: t + 0.1 });
        animate(tag, { opacity: [0, 1], filter: ['blur(8px)', 'blur(0px)'] }, { duration: 0.6, ease: ease.outExpo, delay: t + 0.55 });
      });
    }, (after + 0.4) * 1000);

    // --- The scroll story ---------------------------------------------
    const outs = root.querySelectorAll<HTMLElement>('[data-out]');
    const skin = root.querySelector<HTMLElement>('[data-skin]')!;
    const deck = root.querySelector<HTMLElement>('[data-deck]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
    const sceneParts = scenes.map((sc) => [...sc.querySelectorAll<SVGGElement>('svg > [data-part]')]);
    const pressEl = scenes[scenes.length - 1];
    const pp = (n: string) => pressEl.querySelector<SVGGElement>(`[data-part="${n}"]`);
    const pressParts = Object.fromEntries(Object.keys(PRESS_REST).map((n) => [n, pp(n)]));
    const designSub = pp('design-sub');
    const pb = pressParts.product?.getBBox();
    const pc: [number, number] = pb ? [pb.x + pb.width / 2, pb.y + pb.height / 2] : [0, 0];

    const renderPress = (q: number) => {
      ['base', 'posts', 'panel', 'product', 'paper', 'head'].forEach((n, i) => {
        const a = PT.assemble[0] + i * 0.035;
        const k = inOut(seg(q, a, a + 0.14));
        let w = lerp3(PRESS_FLOAT[n], PRESS_REST[n], k);
        if (n === 'head' && k >= 1) {
          w = [0, 0, OPEN_Z - (OPEN_Z - CLOSED_Z) * inOut(seg(q, PT.close[0], PT.close[1])) + (OPEN_Z - CLOSED_Z) * inOut(seg(q, PT.open[0], PT.open[1]))];
        }
        if (n === 'paper') w = lerp3(w, PEEL, out(seg(q, PT.peel[0], PT.peel[1])));
        const rise = n === 'product' ? inOut(seg(q, PT.rise[0], PT.rise[1])) : 0;
        if (n === 'product') w = lerp3(w, [0, 0, 120], rise);
        move(pressParts[n], w, 1 + rise * 1.1, pc);
        const el = pressParts[n];
        if (!el) return;
        const fade = n === 'product' ? 0 : seg(q, PT.fade[0], PT.fade[1]);
        const gone = n === 'paper' ? seg(q, PT.peel[0] + 0.03, PT.peel[1]) : 0;
        el.style.opacity = String(seg(q, a - 0.02, a + 0.06) * (1 - fade) * (1 - gone));
      });
      const shut = seg(q, PT.close[1] - 0.02, PT.close[1]) * (1 - seg(q, PT.open[0], PT.open[0] + 0.02));
      const hd = pressParts.head;
      if (hd) hd.style.filter = shut > 0 ? `drop-shadow(0 0 ${(22 * shut).toFixed(1)}px color-mix(in oklab, var(--accent) ${Math.round(70 * shut)}%, transparent))` : '';
      if (designSub) designSub.style.opacity = String(seg(q, PT.open[0] + 0.02, PT.peel[1]));
    };

    // A design scene: parts land one after another in the first half of the
    // chapter, then the scene holds until it hands over.
    const renderScene = (i: number, q: number) => {
      const list = sceneParts[i], n = list.length;
      list.forEach((el, j) => {
        const a = 0.04 + j * (0.36 / n);
        const k = inOut(seg(q, a, a + 0.22));
        move(el, lerp3(FLOAT[el.dataset.part!] ?? [0, 0, 80], [0, 0, 0], k));
        el.style.opacity = String(seg(q, a - 0.02, a + 0.08));
      });
    };

    // The skin crops from the full viewport down to the deck's rect.
    let inset = [0, 0, 0, 0], rise = 0, radius = 28;
    const frame = () => {
      radius = parseFloat(getComputedStyle(cards[0]).borderTopLeftRadius) || 28;
      const pr = pin.getBoundingClientRect(), dr = deck.getBoundingClientRect();
      inset = [dr.top - pr.top, pr.right - dr.right, pr.bottom - dr.bottom, dr.left - pr.left];
      rise = pr.bottom - dr.top + 40;
    };
    frame();
    const render = (p: number) => {
      // The hero dissolves where it stands while its surface becomes a card.
      const gone = seg(p, 0.015, INTRO * 0.7);
      outs.forEach((el) => {
        el.style.opacity = String(1 - gone);
        el.style.filter = gone > 0 ? `blur(${(gone * 18).toFixed(1)}px)` : '';
        el.style.scale = gone > 0 ? String(1 - gone * 0.06) : '';
        el.style.visibility = gone >= 1 ? 'hidden' : '';
      });
      if (wires) wires.style.opacity = String(1 - seg(p, 0.01, INTRO * 0.5));
      // The skin's box itself shrinks (not a clip), so its light travels
      // with it and lands exactly where the first card's is.
      const crop = inOut(seg(p, 0.01, INTRO));
      const [t, r, b, l] = inset.map((v) => (v * crop).toFixed(1) + 'px');
      Object.assign(skin.style, { top: t, right: r, bottom: b, left: l, borderRadius: `${(radius * crop).toFixed(1)}px` });
      skin.style.setProperty('--edge', crop.toFixed(3));
      skin.style.opacity = String(1 - seg(p, INTRO * 0.96, INTRO));

      const slide = inOut(seg(p, INTRO * 0.35, INTRO));
      // The next section covering the pinned deck: it sinks back and dims.
      const cover = seg(p, END, 1);
      deck.style.transform = cover > 0 ? `scale(${(1 - cover * 0.08).toFixed(4)})` : '';
      deck.style.opacity = String(1 - cover * 0.5);
      root.querySelector<HTMLElement>('.hero__callouts')!.style.opacity = String(1 - seg(p, END, END + 0.06));
      const chapter = SPANS.findIndex(([a, b], i) => p >= a && (p < b || i === SPANS.length - 1));
      tags.forEach((tag, i) => {
        const [dx, dy] = slots[i] ?? [0, 0];
        tag.style.transform = slide > 0 ? `translate(${(dx * slide).toFixed(1)}px, ${(dy * slide).toFixed(1)}px)` : '';
        tag.classList.toggle('is-on', i === chapter);
        tag.classList.toggle('is-story', slide > 0.5);
      });

      // The deck: card 0 takes over from the cropped skin; every next card
      // rises from below over the last, which sinks back into the stack.
      const arrived = cards.map((_, i) => (i === 0 ? seg(p, INTRO * 0.9, INTRO) : out(seg(p, SPANS[i][0] - 0.03, SPANS[i][0] + 0.05))));
      cards.forEach((card, i) => {
        const k = arrived[i];
        const depth = arrived.slice(i + 1).reduce((a, b) => a + b, 0);
        const y = i === 0 ? 0 : (1 - k) * rise;
        card.style.visibility = k > 0 && depth < 3 ? 'visible' : 'hidden';
        card.style.opacity = i === 0 ? String(k) : '1';
        card.style.transform = `translateY(${(y - depth * 22).toFixed(1)}px) rotate(${(i === 0 ? 0 : (1 - k) * (i % 2 ? 4 : -4)).toFixed(2)}deg) scale(${(1 - depth * 0.05).toFixed(4)})`;
        card.style.setProperty('--dim', Math.min(0.75, depth * 0.4).toFixed(3));
        if (k <= 0 || depth >= 1.5) return;
        const [a, b] = SPANS[i];
        const q = seg(p, a, b);
        i === cards.length - 1 ? renderPress(q) : renderScene(i, q);
      });
    };
    // Scroll sets the target; eased per frame on top of the smooth scroll.
    let now = 0, target = 0, raf = 0;
    const tick = () => {
      now += (target - now) * 0.16;
      if (Math.abs(target - now) < 0.0004) now = target;
      render(now);
      raf = now === target ? 0 : requestAnimationFrame(tick);
    };
    rerender = () => { frame(); render(now); };
    render(0);
    const stop = scroll((p: number) => { target = p; if (!raf) raf = requestAnimationFrame(tick); }, { target: root, offset: ['start start', 'end end'] });
