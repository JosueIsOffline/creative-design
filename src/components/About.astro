---
interface Valor { numero: string; titulo: string; descripcion: string }
interface Props { historia: string; valores?: Valor[] }
const {
  historia,
  valores = [
    { numero: '01', titulo: 'Personalizado', descripcion: 'Cada pieza se hace a tu medida, con tu estilo.' },
    { numero: '02', titulo: 'Hecho a mano', descripcion: 'Sublimación y diseño cuidados en cada detalle.' },
    { numero: '03', titulo: 'Diseño con propósito', descripcion: 'Creatividad que conecta y vende.' },
  ],
} = Astro.props;

const imagen = 'https://images.unsplash.com/photo-1772442126046-29faff1ad234?auto=format&fit=crop&w=1000&q=80';
---
<section id="sobre-la-marca" class="relative max-w-5xl mx-auto px-6 py-20 lg:py-28 scroll-mt-24">
  <div class="film-grain"></div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div class="order-2 lg:order-1 text-center lg:text-left">
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-muted mb-4 block">Estudio — Creative Design</span>
      <h2 data-gsap="kinetic-heading" class="font-display text-4xl sm:text-5xl font-bold uppercase tracking-tight text-accent leading-[0.95] mb-6">
        Sobre la marca
      </h2>
      <p class="text-muted leading-relaxed max-w-md mx-auto lg:mx-0">{historia}</p>
    </div>
    <div class="order-1 lg:order-2 rounded-2xl overflow-hidden aspect-[4/3] lg:aspect-[3/4]">
      <img src={imagen} alt="" loading="lazy" class="w-full h-full object-cover" />
    </div>
  </div>
</section>

<section class="max-w-5xl mx-auto px-6 pb-20 lg:pb-28">
  {valores.map((v) => (
    <div class="valor-row border-b border-border py-8 flex items-baseline justify-between gap-6">
      <div class="flex items-baseline gap-4">
        <span class="font-mono text-xs text-muted">{v.numero}</span>
        <h3 class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-tight">{v.titulo}</h3>
      </div>
      <p class="hidden sm:block font-mono text-xs text-muted leading-relaxed max-w-xs text-right">{v.descripcion}</p>
    </div>
  ))}
</section>
