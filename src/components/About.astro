---
// "Detrás de la marca": Ailyn introduces herself, in her own words (from her
// Instagram presentation post), next to her photo. The photo opens from a
// cropped frame to full as it scrolls into view; the copy uses the site's
// kinetic heading/paragraph reveals. Without JS or with reduced motion: the
// photo simply shown.
import { Image } from 'astro:assets';
import ailyn from '../assets/ailyn-japa.jpg';
---
<section id="sobre-la-marca" class="owner scroll-mt-24" data-owner>
  <div class="owner__inner">
    <figure class="owner__photo" data-owner-photo>
      <Image
        src={ailyn}
        alt="Ailyn Japa, fundadora de Creative Design, de brazos cruzados y sonriendo"
        widths={[480, 720, 1066]}
        sizes="(max-width: 860px) 92vw, 40vw"
        class="owner__img"
        data-owner-img
      />
      <figcaption class="owner__tag">Ailyn Japa · Fundadora</figcaption>
    </figure>

    <div class="owner__copy">
      <span class="owner__eyebrow">Detrás de la marca</span>
      <h2 data-gsap="kinetic-heading" class="owner__title">Mucho gusto, soy Ailyn.</h2>
      <p data-gsap="kinetic-paragraph" class="owner__p">
        Soy la persona detrás de cada idea, cada diseño, cada detalle y cada proyecto que lleva el nombre de Creative Design.
      </p>
      <p data-gsap="kinetic-paragraph" class="owner__p">
        Detrás de este proyecto hay dedicación, esfuerzo, aprendizaje y muchas ideas que poco a poco van tomando forma. Estoy agradecida por cada oportunidad de crecer y seguir construyendo lo que tanto deseo.
      </p>
      <blockquote data-gsap="kinetic-paragraph" class="owner__quote">Muchas ganas de crear cosas bonitas, diferentes y hechas con propósito.</blockquote>
      <p data-gsap="kinetic-paragraph" class="owner__p">Y esto apenas comienza…</p>
      <span class="owner__sign">Ailyn Japa</span>
    </div>
  </div>
</section>

<script>
  import { scroll } from 'motion';

  function mount() {
    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const root of document.querySelectorAll<HTMLElement>('[data-owner]')) {
      const frame = root.querySelector<HTMLElement>('[data-owner-photo]')!;
      const img = root.querySelector<HTMLElement>('[data-owner-img]')!;
      // The frame opens from a cropped window to the full photo while the
      // photo settles from a slight zoom — scrubbed by scroll.
      const stop = scroll(
        (p: number) => {
          const k = 1 - (1 - p) ** 3;
          frame.style.clipPath = `inset(${((1 - k) * 14).toFixed(2)}% ${((1 - k) * 10).toFixed(2)}% round 28px)`;
          img.style.scale = String(1.18 - k * 0.18);
        },
        { target: frame, offset: ['start end', 'center center'] }
      );
      ac.signal.addEventListener('abort', stop);
    }
  }
  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .owner { --accent: var(--color-brand-lilac); position: relative; padding: clamp(80px, 12vw, 160px) 0; overflow: clip; }
  .owner__inner {
    max-width: 72rem; margin: 0 auto; padding: 0 24px;
    display: grid; grid-template-columns: 5fr 6fr; gap: clamp(40px, 6vw, 96px); align-items: center;
  }

  .owner__photo { position: relative; margin: 0; aspect-ratio: 3 / 4; border-radius: 28px; overflow: hidden; clip-path: inset(0 round 28px); }
  /* A lilac glow from below, like the hero's light, behind the portrait. */
  .owner__photo::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, transparent 55%, color-mix(in oklab, var(--color-brand-black) 70%, transparent));
  }
  .owner__photo :global(.owner__img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; transform-origin: 50% 30%; }
  .owner__tag {
    position: absolute; z-index: 1; left: 18px; bottom: 18px; padding: 8px 14px; border-radius: 999px;
    background: color-mix(in oklab, var(--color-brand-black) 55%, transparent); backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklab, #fff 18%, transparent); color: #fff;
    font: 600 11px/1 'Parkinsans', var(--font-display); letter-spacing: 0.14em; text-transform: uppercase;
  }

  .owner__copy { display: grid; gap: 18px; align-content: center; }
  .owner__eyebrow { font: 600 12px/1 'Parkinsans', var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  .owner__title { font: 700 clamp(2.4rem, 5.4vw, 4.6rem)/0.95 'Parkinsans', var(--font-display); letter-spacing: -0.04em; margin-bottom: 6px; }
  .owner__p { color: color-mix(in oklab, var(--foreground) 78%, transparent); font-size: clamp(16px, 1.25vw, 18px); line-height: 1.6; max-width: 48ch; }
  .owner__quote {
    margin: 8px 0; padding-left: 18px; border-left: 2px solid var(--accent); max-width: 30ch;
    font: 600 clamp(1.3rem, 2vw, 1.75rem)/1.25 'Parkinsans', var(--font-display); letter-spacing: -0.02em; color: var(--accent);
  }
  .owner__sign { margin-top: 6px; font-family: var(--font-script); font-size: clamp(2rem, 3.4vw, 2.8rem); color: var(--foreground); }

  @media (max-width: 860px) {
    .owner__inner { grid-template-columns: 1fr; }
    .owner__photo { max-width: 460px; }
  }
</style>
