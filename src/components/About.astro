---
interface Valor { titulo: string; descripcion: string }
interface Props { historia: string; valores?: Valor[] }
const {
  historia,
  valores = [
    { titulo: 'Personalizado', descripcion: 'Cada pieza se hace a tu medida, con tu estilo.' },
    { titulo: 'Hecho a mano', descripcion: 'Sublimación y diseño cuidados en cada detalle.' },
    { titulo: 'Diseño con propósito', descripcion: 'Creatividad que conecta y vende.' },
  ],
} = Astro.props;
---
<section id="sobre-la-marca" class="max-w-2xl mx-auto px-6 py-16 text-center scroll-mt-24">
  <h2 class="font-display text-2xl font-semibold mb-4 text-accent">Sobre la marca</h2>
  <p class="text-muted leading-relaxed">{historia}</p>
</section>

<section class="max-w-3xl mx-auto px-6 pb-16">
  <div class="valor-card grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-6 sm:gap-10 items-center rounded-2xl bg-surface border border-border p-8">
    <span class="font-display text-6xl sm:text-7xl font-extrabold text-accent leading-none text-center sm:text-left">
      {String(valores.length).padStart(2, '0')}
    </span>
    <p class="text-muted leading-relaxed">
      {valores.map((v, i) => (
        <>
          <span class="text-foreground font-semibold">{v.titulo}.</span> {v.descripcion}{i < valores.length - 1 ? ' ' : ''}
        </>
      ))}
    </p>
  </div>
</section>
