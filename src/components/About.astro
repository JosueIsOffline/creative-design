---
interface Props { historia: string; sello?: string }
const { historia, sello = 'Personalizado · Hecho a mano · Con propósito' } = Astro.props;
---
<section id="sobre-la-marca" class="relative max-w-3xl mx-auto px-6 py-24 lg:py-32 text-center scroll-mt-24">
  <div class="film-grain"></div>
  <h2 class="font-mono text-xs tracking-[0.2em] uppercase text-muted mb-8">Sobre la marca</h2>
  <p data-gsap="kinetic-paragraph" class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium leading-snug text-foreground">
    {historia}
  </p>
  <p class="font-script text-2xl sm:text-3xl text-accent mt-10">— Ailyn Japa</p>
  <p class="font-mono text-[0.65rem] tracking-[0.15em] uppercase text-muted mt-12">{sello}</p>
</section>
