---
import { Icon } from 'astro-icon/components';
const instagram = import.meta.env.INSTAGRAM_URL;
const phone = import.meta.env.WHATSAPP_NUMBER;
const currentYear = new Date().getFullYear();
---
<footer class="border-t border-border mt-16 bg-surface pb-24 sm:pb-0">
  <div class="max-w-5xl mx-auto px-6 grid grid-cols-2 sm:grid-cols-4 gap-8 py-16 text-sm">
    <div class="col-span-2 sm:col-span-1">
      <p class="text-muted max-w-[22ch]">Diseño gráfico y sublimación, hechos con amor.</p>
    </div>
    <nav aria-label="Footer">
      <p class="font-mono text-xs tracking-[0.15em] uppercase text-subtle mb-2">Páginas</p>
      <a href="/catalogo" class="block py-0.5 text-muted hover:text-accent transition-colors">Catálogo</a>
      <a href="/#sobre-la-marca" class="block py-0.5 text-muted hover:text-accent transition-colors">Nosotros</a>
    </nav>
    <div>
      <p class="font-mono text-xs tracking-[0.15em] uppercase text-subtle mb-2">Contacto</p>
      <a href={`https://wa.me/${phone}`} target="_blank" rel="noopener noreferrer" class="block py-0.5 text-muted hover:text-accent transition-colors">WhatsApp</a>
    </div>
    <div>
      <p class="font-mono text-xs tracking-[0.15em] uppercase text-subtle mb-2">Seguinos</p>
      <a href={instagram} target="_blank" rel="noopener noreferrer" class="js-hover-fx inline-flex items-center gap-1.5 py-0.5 text-muted hover:text-accent transition-colors">
        <Icon name="simple-icons:instagram" class="w-4 h-4" />
        Instagram
      </a>
    </div>
  </div>

  <div class="overflow-hidden px-6" data-footer-wordmark aria-hidden="true">
    <span class="block font-display font-semibold leading-none tracking-tight text-foreground whitespace-nowrap text-[18vw] sm:text-[14vw] max-w-5xl mx-auto">
      {Array.from('Creative Design').map((letter) => (
        <span class="inline-block" style="display: inline-block">{letter === ' ' ? ' ' : letter}</span>
      ))}
    </span>
  </div>

  <div class="max-w-5xl mx-auto px-6 flex flex-wrap items-center gap-x-6 gap-y-2 py-6 border-t border-border text-xs text-muted font-mono">
    <span>&copy; {currentYear} Creative Design. Todos los derechos reservados.</span>
    <a href="#top" aria-label="Volver arriba" class="ml-auto inline-flex items-center justify-center w-8 h-8 rounded-full border border-border-strong hover:text-accent hover:border-accent transition-colors">
      <Icon name="lucide:arrow-up" class="w-4 h-4" />
    </a>
  </div>
</footer>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Giant wordmark letter reveal, once (adapted from the Halo reference
  // footer). The footer is transition:persist, so the same node sticks
  // around across client-side navigations and astro:page-load can fire
  // again before the user ever scrolls to it — guard at setup time, not
  // just at play time, or repeated mounts would stack duplicate tweens.
  function mount() {
    document.querySelectorAll<HTMLElement>('[data-footer-wordmark]').forEach((root) => {
      if (root.dataset.wordmarkMounted) return;
      root.dataset.wordmarkMounted = 'true';

      const mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        const letters = root.querySelectorAll('span > span');
        gsap.from(letters, {
          yPercent: 60,
          opacity: 0,
          duration: 1,
          stagger: 0.03,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: root,
            start: 'top 85%',
            once: true,
          },
        });
      });
    });
  }

  document.addEventListener('astro:page-load', mount);
</script>
