---
// Glitter from Galería down to Ailyn's section, after bamlab.ch's particle
// canvas: fixed canvases over the page, one swarm. Two layers give it depth:
// the back canvas sits under the gallery photos that are raised (z-index 2,
// Gallery.astro), the front one over everything — so the comet passes
// behind some photos and in front of others. Sparks light up one by one on
// the "Galería" heading (like bam's wordmark), shake off it into loose
// twinkling dust over the photos; scrolling on, it streams across the screen
// as a comet led by our cursor; at "Detrás de la marca" it gathers into a ✨
// on the lower corner of Ailyn's photo (the sparkle she signs her posts with).
// Scroll drives where it is; time only makes it twinkle. Skipped entirely
// with reduced motion.
---
<canvas class="glitter glitter--back" data-glitter="back" aria-hidden="true"></canvas>
<canvas class="glitter glitter--front" data-glitter="front" aria-hidden="true"></canvas>

<script>
  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const smooth = (x: number) => { x = clamp(x); return x * x * (3 - 2 * x); };
  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const burst = (x: number) => (x >= 1 ? 1 : 1 - 2 ** (-10 * x));
  // Where along the scroll the cursor clicks the heading.
  const CLICK = 0.23;
  const gauss = () => (Math.random() + Math.random() + Math.random() - 1.5) / 1.5;

  // The cursor from the hero's "a" (24-unit viewBox), as a Path2D.
  const CURSOR = new Path2D('M4 12l7.07 17 2.51-7.39L21 19.07 4 12z');

  // A ✨: big four-point star plus two small ones. Points are in star units
  // (big star radius 1), mostly on the outline, some filling it.
  function sparklePoints(n: number) {
    const stars = [
      { x: 0, y: 0, r: 1, share: 0.7 },
      { x: 0.15, y: -1.3, r: 0.32, share: 0.18 },
      { x: -0.95, y: 0.7, r: 0.24, share: 0.12 },
    ];
    const pts: [number, number][] = [];
    for (const s of stars) {
      const count = Math.round(n * s.share);
      for (let i = 0; i < count; i++) {
        const t = Math.random() * Math.PI * 2;
        // Astroid (x = cos³, y = sin³): a concave four-point star.
        const fill = Math.random() < 0.72 ? 1 : Math.sqrt(Math.random());
        const c = Math.cos(t), si = Math.sin(t);
        pts.push([s.x + s.r * fill * Math.sign(c) * Math.abs(c) ** 3, s.y + s.r * fill * Math.sign(si) * Math.abs(si) ** 3]);
      }
    }
    while (pts.length < n) pts.push([0, 0]);
    return pts;
  }

  function mount() {
    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    const back = document.querySelector<HTMLCanvasElement>('[data-glitter="back"]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-glitter="front"]');
    const from = document.querySelector<HTMLElement>('[data-gallery]');
    const to = document.querySelector<HTMLElement>('[data-owner]');
    const anchor = document.querySelector<HTMLElement>('[data-owner-photo]');
    if (!canvas || !back || !from || !to || !anchor) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { canvas.remove(); back.remove(); return; }
    const ctx = canvas.getContext('2d')!, bctx = back.getContext('2d')!;

    const small = innerWidth < 810;
    const N = small ? 450 : 900;
    const LAG = small ? 0.26 : 0.2; // how long the comet's tail is, in path units
    const star = sparklePoints(N);
    const P = Array.from({ length: N }, (_, i) => ({
      dust: [Math.random(), Math.random()] as [number, number],
      lag: Math.random() ** 1.6 * LAG,
      spread: gauss(),
      star: star[i],
      size: rand(1.3, 3.2) * (Math.random() < 0.12 ? 1.5 : 1),
      // Only a few big glints get a halo; the rest are crisp dots.
      glint: Math.random() < 0.08,
      behind: Math.random() < 0.5,
      // Each floats on its own slow loop, scroll or not.
      fl: [rand(0.35, 0.9), rand(0.3, 0.8), rand(0, Math.PI * 2)] as [number, number, number],
      tw: rand(1.5, 4.5), ph: rand(0, Math.PI * 2),
      // Mostly warm white; a sprinkle of the cursor's confetti colours.
      hue: Math.random() < 0.8 ? 0 : 1 + Math.floor(Math.random() * 4),
      jit: [gauss(), gauss()] as [number, number],
      // Born on the "Galería" heading, one by one.
      word: [0.5, 0.5] as [number, number],
      birth: rand(0.01, 0.13),
      shake: rand(0, 0.08),
    }));

    // Sample the gallery heading's glyphs: render its text offscreen in its
    // own font and keep points that land on ink, as fractions of its box.
    const heading = from.querySelector<HTMLElement>('h2');
    const sampleWord = () => {
      if (!heading) return;
      const r = heading.getBoundingClientRect(), cs = getComputedStyle(heading);
      const w = Math.ceil(r.width), h = Math.ceil(r.height);
      if (!w || !h) return;
      const cv = document.createElement('canvas'); cv.width = w; cv.height = h;
      const g = cv.getContext('2d', { willReadFrequently: true })!;
      g.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
      g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillStyle = '#000';
      g.fillText(heading.textContent!.trim(), w / 2, h / 2);
      const data = g.getImageData(0, 0, w, h).data, ink: [number, number][] = [];
      for (let y = 0; y < h; y += 2) for (let x = 0; x < w; x += 2) if (data[(y * w + x) * 4 + 3] > 128) ink.push([x / w, y / h]);
      if (ink.length) for (const q of P) q.word = ink[Math.floor(Math.random() * ink.length)];
    };
    sampleWord();
    document.fonts?.ready.then(sampleWord);

    const dark = () => document.documentElement.dataset.theme !== 'light';
    const COLORS = {
      dark: ['#fff1d6', '#e7b8ec', '#ff6fb0', '#ffe066', '#6fdcff'],
      light: ['#9a5aa6', '#b06cbd', '#d4407f', '#c99a10', '#2196bd'],
    };

    // One glow sprite per colour: a hot core with a soft halo, drawn with
    // drawImage — brighter and cheaper than arcs + shadowBlur.
    const sprites: Record<string, HTMLCanvasElement> = {};
    const sprite = (c: string) => {
      if (sprites[c]) return sprites[c];
      const S = 64, cv = document.createElement('canvas');
      cv.width = cv.height = S;
      const g = cv.getContext('2d')!, gr = g.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S / 2);
      gr.addColorStop(0, '#ffffff'); gr.addColorStop(0.12, c); gr.addColorStop(0.32, c + '88'); gr.addColorStop(1, c + '00');
      g.fillStyle = gr; g.fillRect(0, 0, S, S);
      return (sprites[c] = cv);
    };

    let W = 0, H = 0, dpr = 1;
    const resize = () => {
      dpr = Math.min(2, devicePixelRatio || 1);
      W = innerWidth; H = innerHeight;
      sampleWord();
      for (const c of [canvas, back]) { c.width = W * dpr; c.height = H * dpr; }
    };
    resize();
    addEventListener('resize', resize, { signal: ac.signal });

    // The comet's path: a zigzag falling down the screen as you scroll —
    // more swings on phones, threading between the gallery's two columns.
    const TURNS = small ? 2.3 : 1.4, SWING = small ? 0.36 : 0.38;
    const path = (s: number): [number, number] => [
      W * (0.5 + SWING * Math.sin(Math.PI * 2 * s * TURNS - 0.9)),
      H * (0.14 + 0.7 * s) + Math.sin(Math.PI * 2 * s * 3) * H * 0.03,
    ];

    let raf = 0;
    const frame = (now: number) => {
      raf = 0;
      const t = now / 1000;
      const fr = from.getBoundingClientRect(), tr = to.getBoundingClientRect(), ar = anchor.getBoundingClientRect();
      // 0 when the gallery's top reaches the bottom of the screen, 1 when
      // Ailyn's photo is centred.
      const start = fr.top - H, end = ar.top + ar.height / 2 - H / 2;
      const p = clamp(-start / (end - start || 1));
      const live = fr.top < H && tr.bottom > 0;
      for (const c of [ctx, bctx]) { c.setTransform(dpr, 0, 0, dpr, 0, 0); c.clearRect(0, 0, W, H); }
      if (!live) { schedule(); return; }

      const hr = heading ? heading.getBoundingClientRect() : fr;
      const s = (p - 0.3) / 0.5; // the head falls along the path as you scroll (0 → 1 while the comet runs)
      // Star: on the photo's top-right corner, sized to the photo.
      const R = Math.min(ar.width, 420) * 0.26;
      const cx = ar.right - R * 0.7, cy = ar.bottom - R * 1.45; // the photo's lower right corner, over the background, clear of her face
      const pal = dark() ? COLORS.dark : COLORS.light;
      ctx.globalCompositeOperation = 'source-over';

      for (const q of P) {
        // Word → dust: the cursor's click bursts them off the heading — fast
        // out of the letters, slowing as they spread (expo-out), each on its
        // own beat.
        const kd = burst(clamp((p - CLICK - q.shake * 0.25) / 0.12));
        // Dust → comet: the head's neighbours join first.
        const kc = smooth((p - 0.36 - q.lag * 0.6) / 0.2);
        // Comet → ✨: the tail's end lands last.
        const ks = smooth((p - 0.72 - q.lag * 0.5) / 0.18);
        const dx = q.dust[0] * W + Math.sin(t * 0.3 + q.ph) * 14, dy = q.dust[1] * H + Math.cos(t * 0.25 + q.ph) * 14;
        const [px, py] = path(s - q.lag);
        const [nx, ny] = path(s - q.lag + 0.002);
        const len = Math.hypot(nx - px, ny - py) || 1;
        const width = (10 + (q.lag / LAG) ** 1.2 * 70) * (small ? 0.6 : 1); // tight at the head, fanning out toward the tail
        const cxp = px + (-(ny - py) / len) * q.spread * width + q.jit[0] * 2;
        const cyp = py + ((nx - px) / len) * q.spread * width + q.jit[1] * 2;
        const sx = cx + q.star[0] * R + q.jit[0] * 1.2, sy = cy + q.star[1] * R + q.jit[1] * 1.2;
        const wx = hr.left + q.word[0] * hr.width, wy = hr.top + q.word[1] * hr.height;
        let x = wx + (dx - wx) * kd, y = wy + (dy - wy) * kd;
        x += (cxp - x) * kc; y += (cyp - y) * kc;
        x += (sx - x) * ks; y += (sy - y) * ks;
        // Idle float: wide in the loose dust, a gentle bob in the comet and ✨.
        const amp = 1.2 + kd * (1 - kc) * 9 + (q.lag / LAG) * 5 * kc * (1 - ks);
        x += Math.sin(t * q.fl[0] + q.fl[2]) * amp;
        y += Math.cos(t * q.fl[1] + q.fl[2] * 1.3) * amp;

        const tw = 0.75 + 0.25 * Math.sin(t * q.tw + q.ph);
        // Lit one by one: each spark fades and grows in at its own moment.
        const born = smooth((p - q.birth) / 0.05);
        const a = born * (0.65 + 0.35 * Math.max(kc, ks)) * tw;
        if (a < 0.02) continue;
        const r = q.size * (1 - ks * 0.2) * (0.3 + 0.7 * born) * (kd < 1 ? 0.8 + 0.2 * kd : 1);
        // Half the swarm flies behind the raised photos — until the ✨,
        // which is all in front.
        const c = q.behind && ks < 0.5 ? bctx : ctx;
        c.globalAlpha = Math.min(1, a);
        c.fillStyle = pal[q.hue];
        c.beginPath(); c.arc(x, y, r, 0, Math.PI * 2); c.fill();
        if (q.glint) {
          const g = r * 5;
          c.globalAlpha = Math.min(1, a) * 0.55 * tw;
          c.drawImage(sprite(pal[q.hue]), x - g, y - g, g * 2, g * 2);
        }
      }

      // The cursor: flies in, clicks "Galería" (a press and a ripple — the
      // burst above), then moves on to lead the comet, and finally lets the
      // ✨ have the stage.
      const clickAt: [number, number] = [hr.left + hr.width * 0.62, hr.top + hr.height * 0.58];
      const fly = 1 - (1 - smooth((p - 0.11) / (CLICK - 0.12))) ** 3;
      const onward = smooth((p - 0.3) / 0.1);
      const [hx0, hy0] = path(s + 0.012);
      const ex = W * 1.08 + (clickAt[0] - W * 1.08) * fly, ey = clickAt[1] + H * 0.3 * (1 - fly);
      const hx = ex + (hx0 - ex) * onward, hy = ey + (hy0 - ey) * onward;
      const lead = smooth((p - 0.11) / 0.03) * (1 - smooth((p - 0.78) / 0.12));
      const press = Math.sin(Math.PI * clamp((p - CLICK + 0.012) / 0.02));
      const ring = clamp((p - CLICK) / 0.08);
      if (ring > 0 && ring < 1) {
        ctx.globalAlpha = (1 - ring) * 0.9;
        ctx.strokeStyle = pal[1]; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(clickAt[0], clickAt[1], 6 + burst(ring) * 70, 0, Math.PI * 2); ctx.stroke();
        ctx.globalAlpha = (1 - ring) * 0.5;
        ctx.beginPath(); ctx.arc(clickAt[0], clickAt[1], 4 + burst(clamp(ring * 1.4 - 0.2)) * 40, 0, Math.PI * 2); ctx.stroke();
      }
      if (lead > 0.01) {
        ctx.globalCompositeOperation = 'source-over';
        ctx.globalAlpha = lead;
        ctx.save();
        const k = 1.3 * (1 - press * 0.18);
        ctx.translate(hx - 4 * k, hy - 12 * k);
        ctx.scale(k, k);
        ctx.fillStyle = dark() ? '#ffffff' : '#0d0d0c';
        ctx.strokeStyle = ctx.fillStyle; ctx.lineWidth = 1.6; ctx.lineJoin = 'round';
        ctx.fill(CURSOR); ctx.stroke(CURSOR);
        ctx.restore();
      }
      ctx.globalAlpha = 1; bctx.globalAlpha = 1;
      schedule();
    };
    // Keep drawing while the zone is near (it twinkles); idle otherwise.
    const schedule = () => {
      if (ac.signal.aborted) return;
      const fr = from.getBoundingClientRect(), tr = to.getBoundingClientRect();
      if (fr.top < innerHeight * 1.5 && tr.bottom > -innerHeight * 0.5) raf = requestAnimationFrame(frame);
    };
    const wake = () => { if (!raf) schedule(); };
    addEventListener('scroll', wake, { passive: true, signal: ac.signal });
    wake();
    ac.signal.addEventListener('abort', () => cancelAnimationFrame(raf));
  }
  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .glitter { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; }
  .glitter--back { z-index: 1; }
  .glitter--front { z-index: 3; }
</style>
