---
// Glitter from Galería down to Ailyn's section, after bamlab.ch's particle
// canvas: one fixed canvas over the page, one swarm. While the gallery comes
// in it's loose twinkling dust; scrolling on, it streams across the screen
// as a comet led by our cursor; at "Detrás de la marca" it gathers into a ✨
// on the lower corner of Ailyn's photo (the sparkle she signs her posts with).
// Scroll drives where it is; time only makes it twinkle. Skipped entirely
// with reduced motion.
---
<canvas class="glitter" data-glitter aria-hidden="true"></canvas>

<script>
  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const smooth = (x: number) => { x = clamp(x); return x * x * (3 - 2 * x); };
  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const gauss = () => (Math.random() + Math.random() + Math.random() - 1.5) / 1.5;

  // The cursor from the hero's "a" (24-unit viewBox), as a Path2D.
  const CURSOR = new Path2D('M4 12l7.07 17 2.51-7.39L21 19.07 4 12z');

  // A ✨: big four-point star plus two small ones. Points are in star units
  // (big star radius 1), mostly on the outline, some filling it.
  function sparklePoints(n: number) {
    const stars = [
      { x: 0, y: 0, r: 1, share: 0.7 },
      { x: 0.15, y: -1.3, r: 0.32, share: 0.18 },
      { x: -0.95, y: 0.7, r: 0.24, share: 0.12 },
    ];
    const pts: [number, number][] = [];
    for (const s of stars) {
      const count = Math.round(n * s.share);
      for (let i = 0; i < count; i++) {
        const t = Math.random() * Math.PI * 2;
        // Astroid (x = cos³, y = sin³): a concave four-point star.
        const fill = Math.random() < 0.72 ? 1 : Math.sqrt(Math.random());
        const c = Math.cos(t), si = Math.sin(t);
        pts.push([s.x + s.r * fill * Math.sign(c) * Math.abs(c) ** 3, s.y + s.r * fill * Math.sign(si) * Math.abs(si) ** 3]);
      }
    }
    while (pts.length < n) pts.push([0, 0]);
    return pts;
  }

  function mount() {
    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    const canvas = document.querySelector<HTMLCanvasElement>('[data-glitter]');
    const from = document.querySelector<HTMLElement>('[data-gallery]');
    const to = document.querySelector<HTMLElement>('[data-owner]');
    const anchor = document.querySelector<HTMLElement>('[data-owner-photo]');
    if (!canvas || !from || !to || !anchor) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { canvas.remove(); return; }
    const ctx = canvas.getContext('2d')!;

    const small = innerWidth < 810;
    const N = small ? 800 : 1700;
    const LAG = 0.2; // how long the comet's tail is, in path units
    const star = sparklePoints(N);
    const P = Array.from({ length: N }, (_, i) => ({
      dust: [Math.random(), Math.random()] as [number, number],
      lag: Math.random() ** 1.6 * LAG,
      spread: gauss(),
      star: star[i],
      size: Math.random() < 0.14 ? rand(3.2, 5.5) : rand(1.5, 3),
      tw: rand(1.5, 4.5), ph: rand(0, Math.PI * 2),
      // Mostly warm white; a sprinkle of the cursor's confetti colours.
      hue: Math.random() < 0.8 ? 0 : 1 + Math.floor(Math.random() * 4),
      jit: [gauss(), gauss()] as [number, number],
    }));

    const dark = () => document.documentElement.dataset.theme !== 'light';
    const COLORS = {
      dark: ['#fff1d6', '#e7b8ec', '#ff6fb0', '#ffe066', '#6fdcff'],
      light: ['#9a5aa6', '#b06cbd', '#d4407f', '#c99a10', '#2196bd'],
    };

    // One glow sprite per colour: a hot core with a soft halo, drawn with
    // drawImage — brighter and cheaper than arcs + shadowBlur.
    const sprites: Record<string, HTMLCanvasElement> = {};
    const sprite = (c: string) => {
      if (sprites[c]) return sprites[c];
      const S = 64, cv = document.createElement('canvas');
      cv.width = cv.height = S;
      const g = cv.getContext('2d')!, gr = g.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S / 2);
      gr.addColorStop(0, '#ffffff'); gr.addColorStop(0.12, c); gr.addColorStop(0.32, c + '88'); gr.addColorStop(1, c + '00');
      g.fillStyle = gr; g.fillRect(0, 0, S, S);
      return (sprites[c] = cv);
    };

    let W = 0, H = 0, dpr = 1;
    const resize = () => {
      dpr = Math.min(2, devicePixelRatio || 1);
      W = innerWidth; H = innerHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
    };
    resize();
    addEventListener('resize', resize, { signal: ac.signal });

    // The comet's path: a wandering Lissajous across the viewport.
    const path = (s: number): [number, number] => [
      W * (0.5 + 0.4 * Math.sin(Math.PI * 2 * s * 1.15 - 1.2)),
      H * (0.5 + 0.34 * Math.sin(Math.PI * 2 * s * 0.8 + 0.4)),
    ];

    let raf = 0;
    const frame = (now: number) => {
      raf = 0;
      const t = now / 1000;
      const fr = from.getBoundingClientRect(), tr = to.getBoundingClientRect(), ar = anchor.getBoundingClientRect();
      // 0 when the gallery's top reaches the bottom of the screen, 1 when
      // Ailyn's photo is centred.
      const start = fr.top - H, end = ar.top + ar.height / 2 - H / 2;
      const p = clamp(-start / (end - start || 1));
      const live = fr.top < H && tr.bottom > 0;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      if (!live) { schedule(); return; }

      const appear = smooth(p / 0.12);
      const toComet = p; // per-particle staggered below
      const s = 0.1 + p * 1.25; // the head travels along the path with scroll
      const head = path(s);
      // Star: on the photo's top-right corner, sized to the photo.
      const R = Math.min(ar.width, 420) * 0.3;
      const cx = ar.right - R * 0.35, cy = ar.bottom - R * 1.35; // the photo's lower right corner, over the background, clear of her face
      const pal = dark() ? COLORS.dark : COLORS.light;
      ctx.globalCompositeOperation = dark() ? 'lighter' : 'source-over';

      for (const q of P) {
        // Dust → comet: the head's neighbours join first.
        const kc = smooth((toComet - 0.1 - q.lag * 0.6) / 0.22);
        // Comet → ✨: the tail's end lands last.
        const ks = smooth((p - 0.72 - q.lag * 0.5) / 0.18);
        const dx = q.dust[0] * W + Math.sin(t * 0.3 + q.ph) * 14, dy = q.dust[1] * H + Math.cos(t * 0.25 + q.ph) * 14;
        const [px, py] = path(s - q.lag);
        const [nx, ny] = path(s - q.lag + 0.002);
        const len = Math.hypot(nx - px, ny - py) || 1;
        const width = 6 + (q.lag / LAG) ** 1.3 * 56; // tight at the head, fanning out toward the tail
        const cxp = px + (-(ny - py) / len) * q.spread * width + q.jit[0] * 2;
        const cyp = py + ((nx - px) / len) * q.spread * width + q.jit[1] * 2;
        const sx = cx + q.star[0] * R + q.jit[0] * 1.2, sy = cy + q.star[1] * R + q.jit[1] * 1.2;
        let x = dx + (cxp - dx) * kc, y = dy + (cyp - dy) * kc;
        x += (sx - x) * ks; y += (sy - y) * ks;

        const tw = 0.55 + 0.45 * Math.sin(t * q.tw + q.ph);
        const a = appear * (0.55 + 0.45 * Math.max(kc, ks)) * (0.6 + 0.4 * tw);
        if (a < 0.02) continue;
        ctx.globalAlpha = Math.min(1, a) * (1 - ks * 0.25);
        const r = q.size * (2.6 - ks * 1.4); // tighter once they form the ✨, so its shape reads
        ctx.drawImage(sprite(pal[q.hue]), x - r, y - r, r * 2, r * 2);
      }

      // The cursor leads the comet, then lets the ✨ have the stage.
      const lead = smooth((p - 0.12) / 0.12) * (1 - smooth((p - 0.78) / 0.12));
      if (lead > 0.01) {
        const [hx, hy] = path(s + 0.012);
        ctx.globalCompositeOperation = 'source-over';
        ctx.globalAlpha = lead;
        ctx.save();
        ctx.translate(hx - 4 * 1.3, hy - 12 * 1.3);
        ctx.scale(1.3, 1.3);
        ctx.fillStyle = dark() ? '#ffffff' : '#0d0d0c';
        ctx.strokeStyle = ctx.fillStyle; ctx.lineWidth = 1.6; ctx.lineJoin = 'round';
        ctx.fill(CURSOR); ctx.stroke(CURSOR);
        ctx.restore();
      }
      ctx.globalAlpha = 1;
      schedule();
    };
    // Keep drawing while the zone is near (it twinkles); idle otherwise.
    const schedule = () => {
      if (ac.signal.aborted) return;
      const fr = from.getBoundingClientRect(), tr = to.getBoundingClientRect();
      if (fr.top < innerHeight * 1.5 && tr.bottom > -innerHeight * 0.5) raf = requestAnimationFrame(frame);
    };
    const wake = () => { if (!raf) schedule(); };
    addEventListener('scroll', wake, { passive: true, signal: ac.signal });
    wake();
    ac.signal.addEventListener('abort', () => cancelAnimationFrame(raf));
  }
  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .glitter { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 30; pointer-events: none; }
</style>
