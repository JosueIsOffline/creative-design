---
// The scroll story under the hero: a frame draws itself, then the process
// plays inside it chapter by chapter — Diseño, Sublimación, Empaquetado,
// Entrega — each figure blurring into focus with its tag wired to it, the
// same visual language as the hero's callouts. The hero's tags link to the
// chapter anchors here.
import { Icon } from 'astro-icon/components';
import designSvg from '../../tools/design-figure/figure.svg?raw';
import sublimationSvg from '../../tools/heat-press-figure/figure.svg?raw';
import packagingSvg from '../../tools/packaging-figure/figure.svg?raw';

const chapters = [
  { id: 'cap-diseno', tag: 'Diseño', n: '01', text: 'Todo empieza con una idea: la bocetamos y la convertimos en tu diseño.', svg: designSvg },
  { id: 'cap-sublimacion', tag: 'Sublimación', n: '02', text: 'Calor y presión: el diseño pasa a la taza, la camiseta o la funda.', svg: sublimationSvg },
  { id: 'cap-empaquetado', tag: 'Empaquetado', n: '03', text: 'Cada pieza se empaca a mano, lista para sorprender.', svg: packagingSvg },
  { id: 'cap-entrega', tag: 'Entrega', n: '04', text: 'Y llega a tus manos. ¿Empezamos la tuya?', svg: null },
];
---
<section class="story" data-story aria-label="Cómo trabajamos">
  {chapters.map((c, i) => <span class="story__anchor" id={c.id} style={`--i:${i}`}></span>)}
  <div class="story__pin">
    <div class="story__frame" data-frame>
      <svg class="story__border" aria-hidden="true"><rect data-border x="1" y="1" rx="28" ry="28" pathLength="1" /></svg>
      {chapters.map((c) => (
        <article class="story__chapter" data-chapter>
          <svg class="story__wire" aria-hidden="true"><path data-wire pathLength="1" /></svg>
          <span class="story__dot" aria-hidden="true"></span>
          <p class="story__tag">{c.tag}</p>
          <div class="story__figure">
            {c.svg
              ? <div class="anatomy-figure iso" data-theme="dark"><Fragment set:html={c.svg} /></div>
              : <div class="story__done">
                  <span class="story__check"><Icon name="lucide:check" width="56" height="56" /></span>
                  <a class="story__cta" href="/catalogo">Ver catálogo <Icon name="lucide:arrow-right" width="16" height="16" /></a>
                </div>}
          </div>
          <p class="story__text"><span class="story__n">{c.n}</span>{c.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { scroll } from 'motion';

  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const ease = (x: number) => 1 - (1 - x) ** 3;

  for (const root of document.querySelectorAll<HTMLElement>('[data-story]')) {
    if (root.dataset.storyMounted) continue;
    root.dataset.storyMounted = 'true';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const border = root.querySelector<SVGRectElement>('[data-border]')!;
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];
    const FRAME = 0.1, N = chapters.length, SPAN = (1 - FRAME) / N;

    // Wire from the tag's right edge across, a rounded turn, then down to
    // the dot on the figure (50% / 40% of the frame) — in px, like the hero.
    const size = () => {
      const W = frame.offsetWidth, H = frame.offsetHeight;
      border.setAttribute('width', String(W - 2));
      border.setAttribute('height', String(H - 2));
      chapters.forEach((ch) => {
        const tag = ch.querySelector<HTMLElement>('.story__tag')!;
        const x0 = tag.offsetLeft + tag.offsetWidth, y0 = tag.offsetTop + tag.offsetHeight / 2;
        const dx = W * 0.5, dy = H * 0.4, r = 12;
        ch.querySelector('[data-wire]')!.setAttribute('d', `M ${x0} ${y0} H ${dx - r} Q ${dx} ${y0} ${dx} ${y0 + r} V ${dy}`);
      });
    };
    size();
    addEventListener('resize', size);

    const render = (p: number) => {
      // The frame draws itself first, like a wire closing into a box.
      border.style.strokeDashoffset = String(1 - ease(seg(p, 0, FRAME)));
      chapters.forEach((ch, i) => {
        const a = FRAME + i * SPAN, b = a + SPAN;
        const enter = ease(seg(p, a, a + SPAN * 0.3));
        const leave = i === N - 1 ? 0 : seg(p, b - SPAN * 0.18, b);
        const on = enter * (1 - leave);
        ch.style.opacity = String(on);
        ch.style.visibility = on > 0.01 ? 'visible' : 'hidden';
        const fig = ch.querySelector<HTMLElement>('.story__figure')!;
        fig.style.filter = `blur(${(1 - enter) * 24 + leave * 18}px)`;
        fig.style.transform = `translateY(${(1 - enter) * 30 - leave * 30}px) scale(${0.94 + 0.06 * enter})`;
        const wire = ch.querySelector<SVGPathElement>('[data-wire]')!;
        wire.style.strokeDashoffset = String(1 - ease(seg(p, a + SPAN * 0.15, a + SPAN * 0.45)));
        const late = ease(seg(p, a + SPAN * 0.4, a + SPAN * 0.55));
        ch.style.setProperty('--late', String(late));
      });
    };
    render(0);
    scroll((p: number) => render(p), { target: root, offset: ['start start', 'end end'] });
  }
</script>

<style>
  .story {
    --bg: var(--background); --fg: var(--foreground); --accent: var(--color-brand-lilac);
    position: relative; background: var(--bg); color: var(--fg);
  }
  .story__anchor { position: absolute; left: 0; top: 0; }
  .story__frame { position: relative; display: grid; gap: 56px; width: min(92vw, 1000px); margin-inline: auto; padding: 48px 0; }
  .story__border { display: none; }
  .story__chapter { position: relative; display: grid; justify-items: center; gap: 18px; text-align: center; }
  .story__wire, .story__dot { display: none; }
  .story__tag {
    padding: 6px 14px; border: 1px solid color-mix(in oklab, var(--fg) 40%, transparent); border-radius: 999px;
    background: var(--bg); font: 600 11px/1 'Parkinsans', var(--font-display); letter-spacing: 0.14em; text-transform: uppercase;
    color: color-mix(in oklab, var(--fg) 85%, transparent);
  }
  .story__figure { width: min(80vw, 520px); }
  .story__text { max-width: 34ch; font: 500 clamp(17px, 1.6vw, 22px)/1.35 var(--font-display); color: color-mix(in oklab, var(--fg) 85%, transparent); }
  .story__n { display: block; margin-bottom: 6px; font: 600 12px/1 'Parkinsans', var(--font-display); letter-spacing: 0.14em; color: var(--accent); }
  .story__done { display: grid; justify-items: center; gap: 22px; padding: 40px 0; }
  .story__check { display: grid; place-items: center; width: 112px; height: 112px; border-radius: 50%; border: 1.5px solid var(--accent); color: var(--accent); }
  .story__cta {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 999px;
    background: var(--accent); color: var(--color-brand-black); font: 500 15px/1 var(--font-display); text-decoration: none;
  }

  /* Pinned, scroll-driven version (JS on, motion allowed). Without it the
     chapters simply stack, readable top to bottom. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .story { height: 520svh; }
    :global(.js) .story__anchor { top: calc((10% + var(--i) * 22.5%) + 20svh); }
    :global(.js) .story__pin { position: sticky; top: 0; height: 100svh; display: grid; place-items: center; }
    :global(.js) .story__frame { display: block; height: min(74svh, 640px); padding: 0; }
    :global(.js) .story__border { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
    :global(.js) .story__border rect { fill: none; stroke: color-mix(in oklab, var(--fg) 40%, transparent); stroke-width: 1.25; stroke-dasharray: 1; stroke-dashoffset: 1; }
    :global(.js) .story__chapter { position: absolute; inset: 0; display: grid; grid-template-rows: auto 1fr auto; justify-items: center; align-items: center; padding: 28px 28px 32px; opacity: 0; visibility: hidden; }
    :global(.js) .story__tag { justify-self: start; margin-left: 4%; position: relative; z-index: 2; }
    :global(.js) .story__wire { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
    :global(.js) .story__wire path { fill: none; stroke: color-mix(in oklab, var(--fg) 45%, transparent); stroke-width: 1.25; stroke-dasharray: 1; stroke-dashoffset: 1; }
    :global(.js) .story__dot { display: block; position: absolute; left: 50%; top: 40%; width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px; border-radius: 50%; background: var(--fg); z-index: 2; scale: var(--late, 0); }
    :global(.js) .story__figure { width: min(62vw, 440px); max-height: 100%; }
    :global(.js) .story__text { opacity: var(--late, 0); }
  }

  @media (max-width: 809px) {
    :global(.js) .story__figure { width: min(78vw, 340px); }
    :global(.js) .story__tag { margin-left: 2%; }
  }
</style>
