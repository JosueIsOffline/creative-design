---
// Christmas layer for the home's first screen: light snow, a few of the
// brand's four-point sparkles among the flakes. Only with html.is-christmas
// (BaseLayout), fades out over the first screen of scroll, paused while the
// tab is hidden, skipped entirely with reduced motion.
---
<canvas class="snow" data-snow aria-hidden="true"></canvas>

<script>
  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  function mount() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-snow]');
    if (!canvas || canvas.dataset.mounted) return;
    if (!document.documentElement.classList.contains('is-christmas')) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    canvas.dataset.mounted = '1';
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, raf = 0, last = performance.now();

    const resize = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      w = innerWidth; h = innerHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();

    // Fewer flakes on small screens: same density, less work.
    const count = Math.round(Math.min(70, (w * h) / 22000));
    const flakes = Array.from({ length: count }, (_, i) => ({
      x: rand(0, w), y: rand(-h, h), r: rand(0.8, 2.2), vy: rand(14, 38), sway: rand(6, 18),
      phase: rand(0, Math.PI * 2), a: rand(0.35, 0.85), spark: i % 12 === 0, // one in twelve is a ✨
    }));

    const star = (x: number, y: number, s: number) => {
      ctx.beginPath();
      ctx.moveTo(x, y - s);
      ctx.quadraticCurveTo(x, y, x + s, y);
      ctx.quadraticCurveTo(x, y, x, y + s);
      ctx.quadraticCurveTo(x, y, x - s, y);
      ctx.quadraticCurveTo(x, y, x, y - s);
      ctx.fill();
    };

    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      // Gone by the end of the first screen of scroll.
      const fade = Math.max(0, 1 - scrollY / (h * 0.9));
      canvas.style.opacity = String(fade);
      ctx.clearRect(0, 0, w, h);
      if (fade > 0) {
        const light = document.documentElement.dataset.theme === 'light';
        const rgb = light ? '163 90 168' : '255 255 255';
        for (const f of flakes) {
          f.y += f.vy * dt;
          f.phase += dt * 0.8;
          if (f.y - f.r > h) { f.y = -10; f.x = rand(0, w); }
          const x = f.x + Math.sin(f.phase) * f.sway;
          if (f.spark) {
            const tw = 0.55 + 0.45 * Math.sin(now / 600 + f.phase * 3);
            ctx.fillStyle = `rgb(217 168 217 / ${(0.9 * tw).toFixed(3)})`;
            star(x, f.y, 4 + f.r * 2);
          } else {
            ctx.fillStyle = `rgb(${rgb} / ${(f.a * (light ? 0.7 : 1)).toFixed(3)})`;
            ctx.beginPath();
            ctx.arc(x, f.y, f.r, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    const onVisibility = () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) { last = performance.now(); raf = requestAnimationFrame(frame); }
    };
    addEventListener('resize', resize);
    document.addEventListener('visibilitychange', onVisibility);
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', onVisibility);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .snow { position: fixed; inset: 0; z-index: 30; width: 100%; height: 100%; pointer-events: none; display: none; }
  :global(html.is-christmas) .snow { display: block; }
</style>
