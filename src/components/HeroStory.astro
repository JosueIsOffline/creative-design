---
// Hero as scroll storytelling, adapted from the Halo reference's HeroDeck:
// the hero panel itself crops down and turns until it IS the sublimation
// card, the card settles into its slot on a small board, and the design +
// packaging pieces land beside it, staggered, with a caption per step.
// Reduced motion / mobile: the panel, then the finished board — no pin.
import Hero from './Hero.astro';
import sublimationSvg from '../../tools/heat-press-figure/figure.svg?raw';
import designSvg from '../../tools/design-figure/figure.svg?raw';
import packagingSvg from '../../tools/packaging-figure/figure.svg?raw';

interface Props { nombreMarca: string; frase: string }
const { nombreMarca, frase } = Astro.props;

const steps = [
  { key: 'sublimation', svg: sublimationSvg, label: 'Sublimación', text: 'Cada pieza nace del calor y la presión.' },
  { key: 'design', svg: designSvg, label: 'Diseño', text: 'Identidad visual pensada a tu medida.' },
  { key: 'packaging', svg: packagingSvg, label: 'Empaquetado', text: 'Lista para sorprender, lista para entregar.' },
];
const [card, ...tiles] = steps;
---
<section class="relative" data-hero-story>
  <div class="relative motion-safe:lg:h-[420vh]" data-hero-stage>
    <div class="motion-safe:lg:sticky motion-safe:lg:top-0 motion-safe:lg:h-screen motion-safe:lg:overflow-hidden" data-hero-pin>
      <Hero nombreMarca={nombreMarca} frase={frase} />

      <div class="motion-safe:lg:absolute motion-safe:lg:inset-0 hidden lg:grid place-items-center motion-safe:lg:pointer-events-none" data-board aria-hidden="true">
        <div class="grid grid-cols-[1fr_1.1fr_1fr] gap-6 w-[min(88vw,1000px)] h-[min(54vh,460px)] mx-auto py-16">
          <div class="board-piece rounded-2xl border border-border-strong/40 bg-background p-4 flex flex-col" data-tile data-step-key={tiles[0].key}>
            <div class="anatomy-figure iso flex-1 min-h-0" data-theme="dark"><Fragment set:html={tiles[0].svg} /></div>
            <p class="font-mono text-[0.6rem] text-white/50 mt-1 text-center uppercase tracking-[0.15em]">{tiles[0].label}</p>
          </div>
          <div class="board-piece rounded-3xl border border-accent/30 bg-background p-5 shadow-2xl shadow-black/40 flex flex-col" data-card data-step-key={card.key}>
            <div class="anatomy-figure iso flex-1 min-h-0" data-theme="dark"><Fragment set:html={card.svg} /></div>
            <p class="font-mono text-[0.65rem] text-white/60 mt-1.5 text-center uppercase tracking-[0.15em]">{card.label}</p>
          </div>
          <div class="board-piece rounded-2xl border border-border-strong/40 bg-background p-4 flex flex-col" data-tile data-step-key={tiles[1].key}>
            <div class="anatomy-figure iso flex-1 min-h-0" data-theme="dark"><Fragment set:html={tiles[1].svg} /></div>
            <p class="font-mono text-[0.6rem] text-white/50 mt-1 text-center uppercase tracking-[0.15em]">{tiles[1].label}</p>
          </div>
        </div>
      </div>

      <div class="motion-safe:lg:absolute motion-safe:lg:inset-x-0 motion-safe:lg:bottom-8 hidden lg:block motion-safe:lg:opacity-0" data-cap aria-hidden="true">
        <ol class="relative grid place-items-center h-16">
          {steps.map((s, i) => (
            <li class="cap-step motion-safe:lg:[grid-area:1/1] text-center motion-safe:lg:opacity-0" data-step data-step-index={i}>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-accent">{s.label}</span>
              <p class="mt-1 text-sm text-white/70">{s.text}</p>
            </li>
          ))}
        </ol>
        <div class="h-0.5 w-40 mx-auto rounded-full bg-white/10 overflow-hidden mt-2">
          <div class="h-full bg-accent origin-left motion-safe:lg:scale-x-0" data-cap-fill></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Phones/tablets and reduced motion: no pin, no morph — the finished board in normal flow. -->
  <div class="lg:hidden px-6 py-16 bg-background">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto">
      {steps.map((s) => (
        <div class="anatomy-figure iso" data-theme="dark">
          <Fragment set:html={s.svg} />
          <p class="font-mono text-[0.65rem] text-white/60 mt-1 text-center uppercase tracking-[0.15em]">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function mount() {
    const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
    if (!stage || stage.dataset.heroMounted) return;
    stage.dataset.heroMounted = 'true';

    const panel = stage.querySelector<HTMLElement>('#hero-panel');
    const card = stage.querySelector<HTMLElement>('[data-card]');
    const tiles = Array.from(stage.querySelectorAll<HTMLElement>('[data-tile]'));
    const cap = stage.querySelector<HTMLElement>('[data-cap]');
    const fill = stage.querySelector<HTMLElement>('[data-cap-fill]');
    const capSteps = Array.from(stage.querySelectorAll<HTMLElement>('[data-step]'));
    if (!panel || !card || !cap || !fill) return;
    const lit = [card, ...tiles];
    // The Hero's own readable content (headline, chips, subtitle, CTA,
    // "Desliza" cue) — faded out fast, in the first 30% of the morph, so
    // it's gone well before the panel's dramatic turn/crop. Without this
    // the headline stays fully opaque while it rotates and gets sliced by
    // the shrinking clip-path, which reads as broken rather than a morph.
    const copy = Array.from(panel.children) as HTMLElement[];

    const mm = gsap.matchMedia();

    mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      const clamp = (x: number) => Math.min(1, Math.max(0, x));
      const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
      const inOut = (x: number) => (x < 0.5 ? 4 * x ** 3 : 1 - (-2 * x + 2) ** 3 / 2);
      const out = (x: number) => 1 - (1 - x) ** 4;
      const mix = (a: number, b: number, k: number) => a + (b - a) * k;

      // Share of the pinned scroll each beat of the scene owns: the panel
      // morphs into the card, the card settles into its board slot, then
      // the two side pieces land, staggered, after it.
      const MORPH = [0.02, 0.26];
      const SETTLE = [0.3, 0.46];
      const FIRST = 0.44;
      const EVERY = 0.16;
      const LAND = 0.18;

      let big = 1;
      let home = { x: 0, y: 0 };
      let crop = { x: 0, y: 0 };
      let radius = 24;
      let from: { x: number; y: number }[] = [];

      const measure = () => {
        const W = stage.offsetWidth;
        const H = window.innerHeight;
        const cw = card.offsetWidth;
        const ch = card.offsetHeight;
        const bigW = Math.min(0.4 * W, 0.56 * H);
        big = bigW / cw;
        home = {
          x: W / 2 - (card.offsetLeft + cw / 2),
          y: H / 2 - (card.offsetTop + ch / 2),
        };
        crop = {
          x: Math.max(0, (panel.offsetWidth - bigW) / 2),
          y: Math.max(0, (panel.offsetHeight - ch * big) / 2),
        };
        radius = parseFloat(getComputedStyle(card).borderRadius) || 24;
        from = tiles.map((el) => ({
          x: W / 2 - (el.offsetLeft + el.offsetWidth / 2),
          y: H / 2 - (el.offsetTop + el.offsetHeight / 2),
        }));
      };

      let step = -1;
      const render = (now: number) => {
        const m = seg(now, MORPH[0], MORPH[1]);
        const e = inOut(m);
        const k = inOut(seg(m, 0.08, 0.82));
        const turn = Math.sin(Math.PI * e);
        const rz = 22 * turn;
        const grow = 1 + 0.05 * turn;
        const B = inOut(seg(now, SETTLE[0], SETTLE[1]));

        // The panel crops down around the card's centred, oversized window
        // until it disappears — the illusion that the panel IS becoming it.
        panel.style.clipPath = `inset(${crop.y * k}px ${crop.x * k}px round ${mix(28, radius * big, k)}px)`;
        panel.style.transform = `rotateZ(${rz}deg) scale(${grow})`;
        panel.style.opacity = String(1 - seg(m, 0.9, 1));

        const textOut = 1 - seg(m, 0, 0.3);
        copy.forEach((c) => {
          c.style.opacity = String(textOut);
          c.style.visibility = textOut > 0 ? '' : 'hidden';
        });

        const cx = home.x * (1 - B);
        const cy = home.y * (1 - B);
        card.style.transform = `translate3d(${cx}px, ${cy}px, 0) rotateZ(${rz}deg) scale(${grow * mix(big, 1, B)})`;
        // The headline spans edge to edge, so at rest it sits right behind
        // the centred card — this crossfades the two on the same curve
        // (card in as the headline fades out) instead of letting both show
        // fully at once and visually collide before any scroll happens.
        card.style.opacity = String(seg(m, 0, 0.3));

        tiles.forEach((el, i) => {
          const a = FIRST + i * EVERY;
          const T = out(seg(now, a, a + LAND));
          el.style.transform = `translate3d(${from[i].x * (1 - T)}px, ${from[i].y * (1 - T)}px, 0) rotate(${(i % 2 ? 7 : -7) * (1 - T)}deg) scale(${mix(0.6, 1, T)})`;
          el.style.opacity = String(seg(T, 0, 0.3));
        });

        const co = seg(m, 0.85, 1);
        cap.style.opacity = String(co);
        cap.style.transform = `translateY(${16 * (1 - co)}px)`;
        const lastEnd = FIRST + (tiles.length - 1) * EVERY + LAND;
        fill.style.transform = `scaleX(${seg(now, SETTLE[0], lastEnd)})`;

        const s = now < FIRST + LAND / 2 ? 0 : Math.min(tiles.length, Math.floor((now - FIRST - LAND / 2) / EVERY) + 1);
        const settled = now > SETTLE[1] - 0.02;
        if (s !== step) {
          step = s;
          capSteps.forEach((li, i) => li.classList.toggle('is-on', i === s));
          lit.forEach((el, i) => el.toggleAttribute('data-lit', i === s && settled));
        }
      };

      measure();
      render(0);

      const proxy = { p: 0 };
      gsap.to(proxy, {
        p: 1,
        ease: 'none',
        onUpdate: () => render(proxy.p),
        scrollTrigger: {
          trigger: stage,
          start: 'top top',
          end: () => `+=${stage.offsetHeight - window.innerHeight}`,
          scrub: 0.5,
          invalidateOnRefresh: true,
          onRefresh: measure,
        },
      });
    });
  }

  document.addEventListener('astro:page-load', mount);
</script>

<style>
  /* The pinned/absolute storytelling layout only exists with motion allowed
     on desktop — matches the markup's motion-safe:lg: utilities. Without
     it, #hero-panel stays in normal flow (Hero.astro's own layout) and the
     board/captions above render as the plain, already-finished sections
     they are in the DOM: the panel, then the finished board. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
    [data-hero-pin] {
      perspective: 1400px;
    }

    #hero-panel {
      position: absolute;
      inset: 0;
      will-change: transform, clip-path, opacity;
    }

    [data-card],
    [data-tile] {
      will-change: transform, opacity;
    }
  }

  .cap-step {
    transition: opacity 160ms linear;
  }

  .cap-step.is-on {
    opacity: 1 !important;
    transition: opacity 300ms ease-out 120ms;
  }

  [data-cap-fill] {
    transition: none;
  }
</style>
