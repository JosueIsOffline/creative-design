---
// "La pieza se arma": one protagonist, scrubbed by scroll. The sublimation
// press arrives exploded — every assembly floating apart — and puts itself
// together; the head comes down and presses, opens, the transfer sheet
// peels away and the design is left on the piece; then the press fades
// and the finished piece rises out of it. Behind it, one giant word per
// step (Diseñamos · Sublimamos · Empacamos · Entregamos) slides through a
// mask. Without JS or with reduced motion: the assembled press and the
// four steps as a plain list.
import { Icon } from 'astro-icon/components';
import pressSvg from '../../tools/heat-press-figure/figure.svg?raw';

const steps = [
  { word: 'Diseñamos', line: 'Tu idea se convierte en diseño, pieza por pieza.' },
  { word: 'Sublimamos', line: 'Calor y presión: la tinta pasa a la pieza.' },
  { word: 'Empacamos', line: 'Cada pieza se empaca a mano, lista para sorprender.' },
  { word: 'Entregamos', line: 'Y llega a tus manos, hecha con amor.' },
];
---
<section class="press" data-press aria-label="Cómo trabajamos">
  <div class="press__pin">
    <div class="press__words" aria-hidden="true">
      {steps.map((s) => <div class="press__mask"><span class="press__word" data-word>{s.word}</span></div>)}
    </div>

    <div class="press__figure anatomy-figure iso" data-theme="dark" data-figure>
      <Fragment set:html={pressSvg} />
    </div>

    <div class="press__meta">
      <p class="press__label">Proceso</p>
      <p class="press__index"><span data-index>01</span> / 04</p>
    </div>
    <ol class="press__lines">
      {steps.map((s, i) => (
        <li class="press__line" data-line><span class="press__line-n">0{i + 1}</span><span class="sr">{s.word}. </span>{s.line}</li>
      ))}
    </ol>
    <div class="press__rail" aria-hidden="true"><i data-rail></i></div>
    <a class="press__cta" href="/catalogo" data-cta>Ver catálogo <Icon name="lucide:arrow-right" width="16" height="16" /></a>
  </div>
</section>

<script>
  import { scroll } from 'motion';
  import data from '../../tools/heat-press-figure/figure-data.json';

  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const inOut = (x: number) => (x < 0.5 ? 4 * x ** 3 : 1 - (-2 * x + 2) ** 3 / 2);
  const out = (x: number) => 1 - (1 - x) ** 3;
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;
  type V = [number, number, number];
  const lerp3 = (a: V, b: V, k: number): V => [mix(a[0], b[0], k), mix(a[1], b[1], k), mix(a[2], b[2], k)];

  // World offsets (≈ mm of the real machine) → screen px, via the axis
  // vectors the figure's build exports.
  const { x: AX, y: AY, z: AZ } = data.AXES;
  const toScreen = ([x, y, z]: V) => [x * AX[0] + y * AY[0] + z * AZ[0], x * AX[1] + y * AY[1] + z * AZ[1]];
  const move = (el: Element | null, w: V, s = 1, c: [number, number] = [0, 0]) => {
    if (!el) return;
    const [dx, dy] = toScreen(w);
    const grow = s === 1 ? '' : ` translate(${c[0].toFixed(1)} ${c[1].toFixed(1)}) scale(${s.toFixed(3)}) translate(${(-c[0]).toFixed(1)} ${(-c[1]).toFixed(1)})`;
    el.setAttribute('transform', `translate(${dx.toFixed(2)} ${dy.toFixed(2)})${grow}`);
  };

  const { OPEN_Z, CLOSED_Z } = data;
  const PEEL = data.PAPER_PEEL as V;
  // Where each assembly floats when the press is exploded, and where it
  // rests once assembled.
  const EXPLODED: Record<string, V> = {
    base: [0, 0, -70], posts: [-30, -60, 50], panel: [80, -40, 90], product: [0, 30, 70], paper: [0, 40, 150], head: [0, 0, OPEN_Z + 140],
  };
  const REST: Record<string, V> = { base: [0, 0, 0], posts: [0, 0, 0], panel: [0, 0, 0], product: [0, 0, 0], paper: [0, 0, 0], head: [0, 0, OPEN_Z] };

  // Share of the pinned scroll per beat.
  const T = {
    assemble: [0.04, 0.34], close: [0.4, 0.48], open: [0.54, 0.62], peel: [0.6, 0.68],
    fade: [0.7, 0.8], rise: [0.72, 0.95], cta: [0.9, 0.97],
  };
  const WORDS = [0, 0.27, 0.68, 0.84, 1.01]; // step i owns [WORDS[i], WORDS[i+1])

  function mount() {
    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

    for (const root of document.querySelectorAll<HTMLElement>('[data-press]')) {
      if (root.dataset.pressMounted) continue;
      root.dataset.pressMounted = 'true';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

      const fig = root.querySelector<HTMLElement>('[data-figure]')!;
      const part = (n: string) => fig.querySelector(`[data-part="${n}"]`);
      const parts = Object.fromEntries(Object.keys(REST).map((n) => [n, part(n)]));
      const designSub = part('design-sub') as SVGGElement | null;
      const words = [...root.querySelectorAll<HTMLElement>('[data-word]')];
      const lines = [...root.querySelectorAll<HTMLElement>('[data-line]')];
      const index = root.querySelector<HTMLElement>('[data-index]')!;
      const rail = root.querySelector<HTMLElement>('[data-rail]')!;
      const cta = root.querySelector<HTMLElement>('[data-cta]')!;

      const pb = (parts.product as SVGGraphicsElement | null)?.getBBox();
      const pc: [number, number] = pb ? [pb.x + pb.width / 2, pb.y + pb.height / 2] : [0, 0];
      let shownStep = -1;
      const render = (p: number) => {
        // Assembly: each part drops into place on its own beat, top-down
        // last, so the press reads as being built rather than snapping.
        const order = ['base', 'posts', 'panel', 'product', 'paper', 'head'];
        order.forEach((n, i) => {
          const a = T.assemble[0] + i * 0.035;
          const k = inOut(seg(p, a, a + 0.14));
          let w = lerp3(EXPLODED[n], REST[n], k);
          if (n === 'head') {
            const z = OPEN_Z - (OPEN_Z - CLOSED_Z) * inOut(seg(p, T.close[0], T.close[1])) + (OPEN_Z - CLOSED_Z) * inOut(seg(p, T.open[0], T.open[1]));
            w = k < 1 ? w : [0, 0, z];
          }
          if (n === 'paper') w = lerp3(w, PEEL, out(seg(p, T.peel[0], T.peel[1])));
          if (n === 'product') w = lerp3(w, [0, 0, 120], inOut(seg(p, T.rise[0], T.rise[1])));
          const rise = n === 'product' ? inOut(seg(p, T.rise[0], T.rise[1])) : 0;
          move(parts[n], w, 1 + rise * 1.1, pc);
          const el = parts[n] as SVGGElement | null;
          if (!el) return;
          const enter = seg(p, a - 0.02, a + 0.06);
          const fade = n === 'product' ? 0 : seg(p, T.fade[0], T.fade[1]);
          const gone = n === 'paper' ? seg(p, T.peel[0] + 0.03, T.peel[1]) : 0;
          el.style.opacity = String(enter * (1 - fade) * (1 - gone));
        });

        // Heat: the face glows while the press is shut.
        const shut = seg(p, T.close[1] - 0.02, T.close[1]) * (1 - seg(p, T.open[0], T.open[0] + 0.02));
        const head = parts.head as SVGGElement | null;
        if (head) head.style.filter = shut > 0 ? `drop-shadow(0 0 ${(22 * shut).toFixed(1)}px color-mix(in oklab, var(--accent) ${Math.round(70 * shut)}%, transparent))` : '';
        if (designSub) designSub.style.opacity = String(seg(p, T.open[0] + 0.02, T.peel[1]));

        // The whole figure eases in from a soft blur at the start.
        fig.style.filter = `blur(${((1 - seg(p, 0, 0.06)) * 18).toFixed(1)}px)`;

        // Giant words through a mask: the current one in, the last one out.
        const step = Math.max(0, WORDS.findIndex((w, i) => p >= w && p < WORDS[i + 1]));
        words.forEach((el, i) => {
          const a = WORDS[i], b = WORDS[i + 1];
          const enter = out(seg(p, a, a + 0.06)), leave = i === words.length - 1 ? 0 : inOut(seg(p, b - 0.05, b));
          el.style.transform = `translateY(${(1 - enter) * 105 - leave * 105}%)`;
        });
        if (step !== shownStep) {
          shownStep = step;
          index.textContent = `0${step + 1}`;
          lines.forEach((l, i) => l.classList.toggle('is-on', i === step));
        }
        rail.style.transform = `scaleX(${p.toFixed(4)})`;
        const c = seg(p, T.cta[0], T.cta[1]);
        cta.style.opacity = String(c);
        cta.style.visibility = c > 0 ? 'visible' : 'hidden';
      };

      // Scroll sets the target; eased per frame on top of the smooth scroll.
      let now = 0, target = 0, raf = 0;
      const tick = () => {
        now += (target - now) * 0.18;
        if (Math.abs(target - now) < 0.0004) now = target;
        render(now);
        raf = now === target ? 0 : requestAnimationFrame(tick);
      };
      render(0);
      const stop = scroll((p: number) => { target = p; if (!raf) raf = requestAnimationFrame(tick); }, { target: root, offset: ['start start', 'end end'] });
      ac.signal.addEventListener('abort', () => { stop(); cancelAnimationFrame(raf); });
    }
  }
  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .press {
    --bg: var(--background); --fg: var(--foreground); --accent: var(--color-brand-lilac);
    position: relative; background: var(--bg); color: var(--fg);
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Static version (no JS / reduced motion): the assembled press, then the
     four steps as a list. */
  .press__pin { display: grid; justify-items: center; gap: 28px; padding: 80px 24px; }
  .press__words, .press__meta, .press__rail, .press__cta { display: none; }
  .press__figure { width: min(92vw, 640px); }
  /* A step lighter than the site's default anatomy palette — here the
     press is the protagonist on a near-black page, not a small inset. */
  .press__figure.anatomy-figure.iso {
    --anatomy-face: #2a2430; --anatomy-top: #312a38; --anatomy-paper: #241f28;
    --anatomy-shade-0: #1d1922; --anatomy-shade-1: #221d27; --anatomy-shade-2: #28222e; --anatomy-shade-3: #2e2834;
    --anatomy-lit-top: #3d3346; --anatomy-lit-shade: #342c3c;
    --anatomy-mid: #8a8292; --anatomy-lo: #5a5462; --anatomy-faint: #3c3642;
  }
  .press__figure :global(svg) { overflow: visible; }
  .press__lines { display: grid; gap: 14px; max-width: 40ch; }
  .press__line { font: 500 clamp(16px, 1.4vw, 19px)/1.4 var(--font-display); color: color-mix(in oklab, var(--fg) 82%, transparent); }
  .press__line-n { display: inline-block; min-width: 2.4em; font: 600 12px/1 'Parkinsans', var(--font-display); letter-spacing: 0.12em; color: var(--accent); }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .press { height: 720svh; }
    :global(.js) .press__pin { position: sticky; top: 0; height: 100svh; display: block; padding: 0; overflow: hidden; }

    /* One giant word per step, centred behind the press, each in a mask. */
    :global(.js) .press__words { display: grid; position: absolute; inset: 0; place-items: center; }
    :global(.js) .press__mask {
      grid-area: 1 / 1; overflow: clip; padding: 0.04em 0.06em 0.24em;
      font: 700 clamp(4.2rem, 15vw, 15rem)/0.9 'Parkinsans', var(--font-display); letter-spacing: -0.055em;
    }
    :global(.js) .press__word {
      display: block; transform: translateY(105%); will-change: transform;
      color: color-mix(in oklab, var(--accent) 88%, var(--bg));
    }

    :global(.js) .press__figure {
      position: absolute; left: 50%; top: 50%; translate: -50% -46%; z-index: 2;
      width: min(64vw, 820px); will-change: filter;
    }
    :global(.js) .press__figure :global([data-part]) { will-change: transform, opacity; }

    :global(.js) .press__meta { display: block; position: absolute; left: clamp(20px, 4vw, 56px); top: clamp(88px, 12svh, 120px); z-index: 3; }
    :global(.js) .press__label { font: 600 11px/1 'Parkinsans', var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: color-mix(in oklab, var(--fg) 55%, transparent); }
    :global(.js) .press__index { margin-top: 10px; font: 600 clamp(20px, 2vw, 28px)/1 'Parkinsans', var(--font-display); letter-spacing: -0.02em; }
    :global(.js) .press__index span { color: var(--accent); }

    :global(.js) .press__lines { position: absolute; left: clamp(20px, 4vw, 56px); bottom: clamp(28px, 7svh, 64px); z-index: 3; display: grid; max-width: 30ch; gap: 0; }
    :global(.js) .press__line { grid-area: 1 / 1; opacity: 0; translate: 0 10px; transition: opacity 180ms linear, translate 0s 180ms; }
    :global(.js) .press__line.is-on { opacity: 1; translate: 0 0; transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1) 180ms, translate 500ms cubic-bezier(0.16, 1, 0.3, 1) 180ms; }
    :global(.js) .press__line-n { display: block; margin-bottom: 8px; }

    :global(.js) .press__rail { display: block; position: absolute; left: clamp(20px, 4vw, 56px); right: clamp(20px, 4vw, 56px); top: 0; height: 2px; z-index: 3; background: color-mix(in oklab, var(--fg) 10%, transparent); }
    :global(.js) .press__rail i { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }

    :global(.js) .press__cta {
      display: inline-flex; align-items: center; gap: 10px; position: absolute; right: clamp(20px, 4vw, 56px); bottom: clamp(28px, 7svh, 64px); z-index: 3;
      min-height: 48px; padding: 0 22px; border-radius: 999px; background: var(--accent); color: var(--color-brand-black);
      font: 500 15px/1 var(--font-display); text-decoration: none; opacity: 0; visibility: hidden;
    }
  }

  @media (max-width: 809px) {
    :global(.js) .press__figure { width: 96vw; translate: -50% -52%; }
    :global(.js) .press__lines { right: 20px; bottom: 96px; }
    :global(.js) .press__cta { left: 20px; right: auto; }
  }
</style>
