---
// A faithful port of the Halo reference template's HeroDeck.astro: same
// math, same CSS, same structure — only the content changed. Halo's own
// tokens are scoped to .show below so the rest of the site keeps its own
// brand tokens untouched; HeroStory.astro stays in the codebase, on hold,
// in case we go back to it.
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import catalogoPreview from '../assets/hero/catalogo-preview.jpg';
import sublimationSvg from '../../tools/heat-press-figure/figure.svg?raw';
import designSvg from '../../tools/design-figure/figure.svg?raw';
import packagingSvg from '../../tools/packaging-figure/figure.svg?raw';

const whatsapp = import.meta.env.WHATSAPP_NUMBER;
const waMessage = encodeURIComponent('Hola! Quiero más información sobre Creative Design.');

const h = {
  lead: 'Diseño gráfico y sublimación: artículos personalizados y piezas de diseño hechas con amor.',
  button: 'Ver catálogo',
  href: '/catalogo',
  button2: 'Escribinos',
  href2: `https://wa.me/${whatsapp}?text=${waMessage}`,
  art: 'Prensa de sublimación, ilustración isométrica',
};

const b = {
  identity: { label: 'Identidad', name: 'Creative Design', type: 'Space Grotesk' },
  packaging: { label: 'Empaquetado', line: 'Lista para entregar' },
  design: { label: 'Diseño', line: 'Antes de imprimir' },
  web: { label: 'Catálogo', url: '/catalogo', line: 'Todo en un clic' },
  steps: [
    { day: '01', text: 'Cada pieza nace del calor y la presión.' },
    { day: '02', text: 'Tu marca, tu estilo, en cada detalle.' },
    { day: '03', text: 'Lista para sorprender, lista para entregar.' },
    { day: '04', text: 'Ideas que cobran forma antes de imprimirse.' },
    { day: '05', text: 'Todo tu catálogo, a un clic de distancia.' },
  ],
  button: 'Ver catálogo completo',
  href: '/catalogo',
};
const star = 'M12 0C12.8 7.2 16.8 11.2 24 12C16.8 12.8 12.8 16.8 12 24C11.2 16.8 7.2 12.8 0 12C7.2 11.2 11.2 7.2 12 0Z';
---
<section class="show" data-show>
  <div class="show__pin">
    <div class="panel" data-panel>
      <h1 class="panel__title display" data-copy>
        <span class="panel__line">
          <span data-line>
            <span class="sr-only">Creative Design</span>
            <span aria-hidden="true">
              Cre<svg viewBox="-8 0 32 32" class="panel__cursor" data-cursor fill="none">
                <g transform="rotate(-1 12.5 20.5)">
                  <g transform="translate(4,4) rotate(15)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="currentColor" /></g>
                  <g transform="translate(-1,6) rotate(-40)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#f7d842" /></g>
                  <g transform="translate(-4,10) rotate(-80)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#e85fa0" /></g>
                  <g transform="translate(-3,15) rotate(-115)"><rect x="-0.65" y="-2" width="1.3" height="4" rx="0.65" fill="#5ec8e8" /></g>
                  <path d="M4 12l7.07 17 2.51-7.39L21 19.07 4 12z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                </g>
              </svg>tive Design
            </span>
          </span>
        </span>
      </h1>
      <div class="panel__foot" data-copy data-in>
        <p class="panel__lead">{h.lead}</p>
        <div class="panel__cta">
          <a class="btn btn--solid" href={h.href}>{h.button}<Icon name="lucide:arrow-right" width="16" height="16" class="icon icon--after" /></a>
          <a class="btn" href={h.href2} target="_blank" rel="noopener">{h.button2}</a>
        </div>
      </div>
    </div>

    <h2 class="sr">Cómo trabajamos</h2>
    <div class="stage">
      <div class="board">
        <article class="tile tile--id" data-tile>
          <p class="tile__label">{b.identity.label}</p>
          <p class="tile__mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={star} /></svg>{b.identity.name}</p>
          <div class="tile__row" aria-hidden="true"><span class="tile__swatches"><i></i><i></i><i></i><i></i></span><span class="tile__aa">{b.identity.type}</span></div>
        </article>
        <article class="key" data-card>
          <div class="anatomy-figure iso key__figure" data-theme="dark" aria-label={h.art}><Fragment set:html={sublimationSvg} /></div>
        </article>
        <article class="tile tile--ad on-photo" data-tile>
          <div class="anatomy-figure iso tile__figure" data-theme="dark"><Fragment set:html={packagingSvg} /></div>
          <p class="tile__label">{b.packaging.label}</p>
          <p class="tile__line">{b.packaging.line}</p>
        </article>
        <article class="tile tile--film on-photo" data-tile>
          <div class="anatomy-figure iso tile__figure" data-theme="dark"><Fragment set:html={designSvg} /></div>
          <p class="tile__label">{b.design.label}</p>
          <p class="tile__line">{b.design.line}</p>
        </article>
        <article class="tile tile--web" data-tile>
          <p class="tile__bar"><span class="tile__label">{b.web.label}</span><span class="tile__url">{b.web.url}</span></p>
          <div class="tile__page on-photo">
            <Image src={catalogoPreview} alt="Vista previa del catálogo" fill sizes="(max-width: 809px) 60vw, 480px" />
            <p class="tile__line">{b.web.line}</p>
          </div>
        </article>
      </div>
    </div>

    <div class="cap" data-cap>
      <ol class="cap__steps">
        {b.steps.map((s) => <li data-step><span class="cap__day label">{s.day}</span><span class="cap__text">{s.text}</span></li>)}
      </ol>
      <div class="cap__rail" aria-hidden="true"><i data-fill></i></div>
      <div class="cap__cta" data-late>
        <a class="btn" href={b.href}>{b.button}<Icon name="lucide:arrow-right" width="16" height="16" class="icon icon--after" /></a>
      </div>
    </div>

    <!-- The cursor from the headline reappears here, tapping each piece of
         the board as its own caption becomes active — it leads the story. -->
    <div class="click-mark" data-click aria-hidden="true">
      <svg viewBox="-8 0 32 32"><path d="M4 12l7.07 17 2.51-7.39L21 19.07 4 12z" /></svg>
    </div>
  </div>
</section>

<script>
  import { animate, scroll, stagger } from 'motion';

  // Ported from Halo's src/scripts/motion.ts — only the two helpers this
  // component actually uses (the rest of that file is site-wide hover/
  // reveal/parallax helpers this component doesn't need).
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = { outExpo: [0.16, 1, 0.3, 1] as const };

  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a)); // 0→1 while p runs from a to b
  const inOut = (x: number) => (x < 0.5 ? 4 * x ** 3 : 1 - (-2 * x + 2) ** 3 / 2);
  const out = (x: number) => 1 - (1 - x) ** 4;
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;

  // The scene's timeline (share of the pinned scroll): the panel becomes the card, the card settles, a tile lands per step.
  const MORPH = [0.02, 0.24], SETTLE = [0.28, 0.42], FIRST = 0.4, EVERY = 0.12, LAND = 0.14;
  // Where the two front tiles peek out from behind the portrait in the hero (in card widths / heights) and how they lean.
  const PEEK = [{ x: -0.5, y: -0.2, r: -10 }, { x: 0.52, y: 0.16, r: 9 }];

  for (const root of document.querySelectorAll<HTMLElement>('[data-show]')) {
    if (reduced()) continue;
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const panel = $('[data-panel]'), card = $('[data-card]'), cap = $('[data-cap]'), fill = $('[data-fill]'), stage = $('.stage');
    const cursorIcon = root.querySelector<SVGElement>('[data-cursor]');
    const clickMark = root.querySelector<HTMLElement>('[data-click]');
    const copy = root.querySelectorAll<HTMLElement>('[data-copy]');
    const late = root.querySelectorAll<HTMLElement>('[data-late]');
    const tiles = [...root.querySelectorAll<HTMLElement>('[data-tile]')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const lit = [card, ...tiles];
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

    // Sizes. The card's own box is its small place on the board; in the hero it is scaled up (big) and moved to the centre.
    let phone = false, big = 1, home = { x: 0, y: 0 }, rest = { x: 0, y: 0, s: 1 }, crop = { x: 0, y: 0 }, radius = 20;
    let from: { x: number; y: number }[] = [], peekScale = 1;
    const measure = () => {
      phone = innerWidth < 810;
      const W = stage.offsetWidth, H = stage.offsetHeight, cw = card.offsetWidth, ch = card.offsetHeight;
      const bigW = phone ? Math.min(0.66 * W, 0.42 * H) : Math.min(0.36 * W, 0.51 * H);
      big = bigW / cw;
      home = { x: W / 2 - (card.offsetLeft + cw / 2), y: H / 2 - (card.offsetTop + ch / 2) };
      rest = { x: W * 0.1, y: H * 0.03, s: 0.84 };
      if (phone) { // on phones the card rests in the gap between the headline and the lead, as big as the gap allows
        const title = panel.querySelector<HTMLElement>('.panel__title')!, foot = panel.querySelector<HTMLElement>('.panel__foot')!;
        const top = title.offsetTop + title.offsetHeight, gap = foot.offsetTop - top;
        rest = { x: W * 0.2, y: panel.offsetTop + top + gap / 2 - H / 2, s: Math.max(0.3, Math.min(0.56, (gap - 24) / (ch * big))) };
      }
      crop = { x: (panel.offsetWidth - bigW) / 2, y: (panel.offsetHeight - ch * big) / 2 };
      radius = parseFloat(getComputedStyle(card).borderTopLeftRadius) || 20;
      from = tiles.map((el) => ({ x: W / 2 - (el.offsetLeft + el.offsetWidth / 2), y: H / 2 - (el.offsetTop + el.offsetHeight / 2) }));
      peekScale = (bigW * rest.s * 0.8) / tiles[0].offsetWidth;
    };

    let open = 0; // the entrance: the panel opens from its centre
    let target = 0, now = 0, raf = 0;
    const ptr = { x: 0, y: 0, tx: 0, ty: 0 }; // pointer, -0.5 … 0.5 from the centre of the screen
    let step = -1;
    const render = () => {
      const m = seg(now, MORPH[0], MORPH[1]), e = inOut(m); // the morph: panel → card
      const k = inOut(seg(m, 0.08, 0.82));                  // how far the panel has cropped around the card
      const turn = Math.sin(Math.PI * e);                    // 0 → 1 → 0: the turn swings out and back
      const rz = 30 * turn, rx = 12 * turn, grow = 1 + 0.06 * turn;
      const B = inOut(seg(now, SETTLE[0], SETTLE[1]));       // the card leaves the centre for its place on the board
      const calm = 1 - seg(m, 0, 0.3);                       // pointer depth only while the hero is at rest

      const ix = mix(crop.x, 0.2 * panel.offsetWidth, 1 - open), iy = mix(crop.y, 0.3 * panel.offsetHeight, 1 - open);
      panel.style.clipPath = `inset(${iy * Math.max(k, 1 - open)}px ${ix * Math.max(k, 1 - open)}px round ${mix(28, radius * big, k)}px)`;
      panel.style.transform = `rotateX(${rx}deg) rotateZ(${rz}deg) scale(${grow})`;
      panel.style.opacity = String(1 - seg(m, 0.9, 1)); // hidden once the card fully covers it

      const cx = home.x * (1 - B) + rest.x * (1 - k) + ptr.x * 14 * calm, cy = home.y * (1 - B) + rest.y * (1 - k) + ptr.y * 10 * calm;
      card.style.transform = `translate3d(${cx}px, ${cy}px, 0) rotateX(${rx - ptr.y * 5 * calm}deg) rotateY(${ptr.x * 7 * calm}deg) rotateZ(${rz}deg) scale(${grow * mix(big * mix(rest.s, 1, k), 1, B)})`;

      tiles.forEach((el, i) => {
        const a = FIRST + i * EVERY, T = out(seg(now, a, a + LAND));
        const peek = PEEK[i], show = peek && !phone ? calm * open : 0;
        if (T > 0 || !show) { // on its way to (or at) its place on the board
          el.style.transform = `translate3d(${from[i].x * (1 - T)}px, ${from[i].y * (1 - T)}px, 0) rotate(${(i % 2 ? 7 : -7) * (1 - T)}deg) scale(${mix(0.55, 1, T)})`;
          el.style.opacity = String(seg(T, 0, 0.35));
        } else { // tucked behind the portrait in the hero, leaning out at the sides
          const bw = card.offsetWidth * big * rest.s, bh = card.offsetHeight * big * rest.s, d = i ? 1 : -1;
          el.style.transform = `translate3d(${from[i].x + rest.x + peek.x * bw * calm + ptr.x * d * 30}px, ${from[i].y + rest.y + peek.y * bh * calm + ptr.y * d * 22}px, 0) rotate(${peek.r * calm}deg) scale(${peekScale})`;
          el.style.opacity = String(show);
        }
      });

      copy.forEach((c) => { const o = 1 - seg(m, 0, 0.3); c.style.opacity = String(o); c.style.visibility = o > 0 ? '' : 'hidden'; }); // hidden = out of the Tab order too
      // The cursor standing in for the "a" of "Creative" drags itself off as the
      // headline fades — same 0 -> 0.3 window — as if it were the thing pulling
      // the panel open to reveal the card underneath.
      if (cursorIcon) {
        const drag = out(seg(m, 0, 0.3));
        cursorIcon.style.transform = `translate(${drag * 20}px, ${drag * 16}px) rotate(${-14 * drag}deg) scale(${mix(1, 0.75, drag)})`;
      }
      const co = seg(m, 0.85, 1);
      cap.style.opacity = String(co); cap.style.translate = `0 ${16 * (1 - co)}px`;
      fill.style.transform = `scaleX(${seg(now, SETTLE[0], FIRST + 3 * EVERY + LAND)})`;
      late.forEach((l) => { const o = seg(now, 0.9, 0.96); l.style.opacity = String(o); l.style.pointerEvents = o > 0.5 ? '' : 'none'; l.style.visibility = o > 0 ? '' : 'hidden'; });
      const s = now < FIRST + LAND / 2 ? 0 : Math.min(tiles.length, Math.floor((now - FIRST - LAND / 2) / EVERY) + 1);
      const settled = now > SETTLE[1] - 0.02;
      if (s !== step || lit[0].classList.contains('is-lit') !== (settled && s === 0)) {
        const arrived = s !== step && (s > 0 || settled); // the card only counts once it's actually settled, not mid-flight
        step = s;
        steps.forEach((li, i) => li.classList.toggle('is-on', i === s));
        lit.forEach((el, i) => el.classList.toggle('is-lit', i === s && settled));
        // The same cursor taps each piece as its caption takes over — the
        // story has one guide throughout, not just an opening flourish.
        if (arrived && clickMark && lit[s]) {
          const r = lit[s].getBoundingClientRect();
          clickMark.style.left = `${r.left + r.width / 2}px`;
          clickMark.style.top = `${r.top + r.height / 2}px`;
          animate(clickMark, { scale: [0, 1.15, 1, 0], opacity: [0, 1, 1, 0] }, { duration: 0.7, ease: 'easeOut' });
        }
      }
    };
    // Scroll sets the target; the scene eases toward it every frame, so wheel steps glide like a smooth scroll.
    const tick = () => {
      now += (target - now) * 0.14;
      if (Math.abs(target - now) < 0.0004) now = target;
      ptr.x += (ptr.tx - ptr.x) * 0.08; ptr.y += (ptr.ty - ptr.y) * 0.08;
      const still = Math.abs(ptr.tx - ptr.x) + Math.abs(ptr.ty - ptr.y) < 0.002;
      render();
      raf = now === target && still ? 0 : requestAnimationFrame(tick);
    };
    const wake = () => { if (!raf) raf = requestAnimationFrame(tick); };
    measure(); addEventListener('resize', () => { measure(); render(); });
    scroll((p: number) => { target = p; wake(); }, { target: root, offset: ['start start', 'end end'] });
    // Keyboard focus on the late case link: jump to the end of the scene, where it is shown.
    late.forEach((l) => l.addEventListener('focusin', () => { if (now < 0.96) scrollTo(0, root.offsetTop + root.offsetHeight - innerHeight); }));
    // Pointer depth on desktop: the portrait and the two tiles behind it shift by different amounts.
    if (fine) root.addEventListener('pointermove', (ev) => { ptr.tx = ev.clientX / innerWidth - 0.5; ptr.ty = ev.clientY / innerHeight - 0.5; if (now < MORPH[1]) wake(); });

    // Entrance: the panel opens, the lines rise one by one, then the cards and the rest.
    const delay = 0.1;
    animate(0, 1, { duration: 0.9, ease: ease.outExpo, delay: delay - 0.1, onUpdate: (v) => { open = v; render(); } });
    animate(root.querySelectorAll('[data-line]'), { y: ['105%', '0%'] }, { duration: 1.1, ease: ease.outExpo, delay: stagger(0.09, { startDelay: delay + 0.15 }) });
    animate(card, { opacity: [0, 1] }, { duration: 1.1, ease: ease.outExpo, delay: delay + 0.3 });
    animate(root.querySelectorAll('[data-in]'), { opacity: [0, 1], y: [24, 0] }, { duration: 1, ease: ease.outExpo, delay: delay + 0.2 });
  }
</script>

<style>
  /* Halo's own token NAMES (HeroDeck's CSS references these), but pointed
     at our own brand colors (src/styles/global.css) instead of Halo's
     violet/lime preset — structure and motion stay exactly Halo's, only
     the palette is ours. These resolve through the theme toggle too,
     since they reference our real :root custom properties. */
  .show {
    /* --color-surface / --color-muted (Tailwind's @theme inline aliases),
       not --surface / --muted directly: this rule redeclares those two
       names below for Halo's own CSS, and a custom property that's
       redeclared in the same rule always resolves to its last value —
       referencing the bare name here would just point back at itself. */
    --bg: var(--background); --bg-2: var(--color-surface); --fg: var(--foreground); --muted: var(--color-muted);
    --accent: var(--color-brand-lilac); --accent-ink: var(--color-brand-black);
    --glow: var(--color-brand-lilac); --glow-2: color-mix(in oklab, var(--color-brand-lilac) 70%, white 30%);
    --scrim: color-mix(in oklab, var(--bg) 60%, transparent);
    --surface: color-mix(in oklab, var(--fg) 5%, transparent);
    --line: color-mix(in oklab, var(--fg) 14%, transparent);
    /* Toned down from Halo's own mix (38%/62% glow) — full violet read as
       too loud against a brand that otherwise keeps lilac as a sparse
       accent, not a dominant wash. Mostly our near-black, with a soft
       lilac glow low-right instead of a saturated purple panel. */
    --stage-bg: radial-gradient(80% 70% at 60% 110%, color-mix(in oklab, var(--glow-2) 55%, transparent), color-mix(in oklab, var(--glow) 28%, transparent) 40%, transparent 85%),
      linear-gradient(160deg, color-mix(in oklab, var(--glow) 12%, var(--bg)), color-mix(in oklab, var(--glow) 22%, var(--bg)));
    /* Space Grotesk is already loaded site-wide (global.css) and is the
       body's own font (BaseLayout's <body> carries font-display) — so
       --text uses it too, matching how the rest of the site reads. */
    --display: var(--font-display);
    --text: var(--font-display);
    --label: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --r: 20px; --r-sm: 999px; --r-lg: 28px;
    --dur-1: 400ms;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --gut: clamp(16px, 2.5vw, 32px);
    --w: 1280px;
    --head: 72px;
    --space: clamp(88px, 11vw, 160px);
    --fs-hero: clamp(3.2rem, 8.4vw, 8.5rem);
    --gap: 16px;
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 48px; padding: 0 22px; border: 1px solid var(--line); border-radius: var(--r-sm);
    background: var(--surface); color: var(--fg); font: 500 15px/1 var(--text); text-decoration: none; white-space: nowrap;
    transition: background-color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out), scale 200ms var(--ease-out);
  }
  .btn--solid { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .btn:active { scale: 0.97; }
  .btn .icon { transition: translate var(--dur-1) var(--ease-out); }
  @media (hover: hover) {
    .btn:hover { background: color-mix(in oklab, var(--fg) 12%, transparent); border-color: color-mix(in oklab, var(--fg) 30%, transparent); }
    .btn--solid:hover { background: color-mix(in oklab, var(--accent) 86%, var(--fg)); border-color: transparent; }
    .btn:hover .icon--after { translate: 3px 0; }
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Light ground around the panel: the page ink, so every preset keeps its contrast. */
  .show { position: relative; background: var(--fg); color: var(--bg); overflow: clip; }
  .show__pin { display: grid; gap: clamp(40px, 5vw, 64px); justify-items: center; padding: 12px 12px var(--space); }

  /* The panel */
  .panel {
    position: relative; width: 100%; min-height: calc(100svh - 24px); display: grid; grid-template-rows: auto 1fr auto; overflow: hidden;
    padding: calc(var(--head) + 20px) clamp(20px, 3vw, 44px) clamp(24px, 3vw, 44px);
    border-radius: var(--r-lg); background: var(--stage-bg); color: var(--fg);
  }
  .panel__title { position: relative; z-index: 2; --size: var(--fs-hero); font-family: var(--display); font-weight: 560; font-size: var(--size); line-height: 0.95; letter-spacing: -0.045em; color: var(--accent); }
  .panel__title em { font-style: normal; color: color-mix(in oklab, var(--glow-2) 70%, var(--fg)); }
  /* The cursor icon standing in for the "a" of "Creative" — Hero.astro's own trick, ported as-is. */
  .panel__cursor { display: inline-block; height: 0.8em; width: auto; vertical-align: baseline; margin-inline: -0.2em; color: var(--fg); transform-origin: 50% 50%; will-change: transform; }

  /* The cursor's second appearance: a brief tap on whichever piece the
     caption is currently telling you about. Positioned in JS (left/top,
     viewport coordinates), animated in JS (motion's animate()) — this
     rule only sets its rest/shape. */
  .click-mark {
    position: fixed; top: 0; left: 0; z-index: 5; width: 28px; height: 28px;
    /* Rest scale lives on `transform`, not the standalone `scale` property —
       motion's animate() writes scale keyframes to `transform`, and the two
       compose (multiply) rather than one overriding the other, so a
       standalone `scale: 0` here would permanently zero the element no
       matter what `transform` animates to. */
    translate: -50% -50%; opacity: 0; transform: scale(0); pointer-events: none; color: var(--accent);
  }
  .click-mark svg { width: 100%; height: 100%; fill: currentColor; filter: drop-shadow(0 2px 6px color-mix(in oklab, var(--bg) 60%, transparent)); }
  .panel__line { display: block; overflow: clip; padding-bottom: 0.06em; }
  .panel__line > span { display: inline-block; }
  .panel__foot { grid-row: 3; position: relative; z-index: 2; display: grid; gap: 22px; max-width: 34rem; }
  .panel__lead { color: color-mix(in oklab, var(--fg) 82%, transparent); font-size: clamp(16px, 1.3vw, 19px); line-height: 1.45; max-width: 36ch; }
  .panel__cta { display: flex; flex-wrap: wrap; gap: 10px; }

  /* The board: the portrait in the middle, two tiles either side. Without motion this is simply how it looks. */
  .stage { width: min(100%, var(--w)); padding-inline: var(--gut); }
