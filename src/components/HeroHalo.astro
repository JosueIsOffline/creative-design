  .tile__swatches i { width: 9cqi; height: 9cqi; border-radius: 50%; border: 1px solid var(--bg-2); background: var(--glow); }
  .tile__swatches i + i { margin-left: -2.4cqi; }
  .tile__swatches i:nth-child(2) { background: var(--glow-2); } .tile__swatches i:nth-child(3) { background: var(--accent); } .tile__swatches i:nth-child(4) { background: var(--fg); }
