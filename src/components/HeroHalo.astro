  :global(.js) .show .cap__steps li { grid-area: 1 / 1; justify-items: center; opacity: 0; translate: 0 12px; transition: opacity 160ms linear, translate 0s 160ms; }
  :global(.js) .show .cap__steps li.is-on { opacity: 1; translate: 0 0; transition: opacity var(--dur-1) var(--ease-out) 160ms, translate var(--dur-1) var(--ease-out) 160ms; }
  :global(.js) .show .cap__text { font-size: clamp(22px, 2.8vw, 42px); letter-spacing: -0.035em; }
  :global(.js) .show .cap__rail { display: block; width: min(240px, 50%); height: 2px; border-radius: 2px; background: color-mix(in oklab, var(--bg) 14%, transparent); overflow: hidden; }
  :global(.js) .show .cap__rail i { display: block; height: 100%; background: var(--bg); transform-origin: 0 50%; transform: scaleX(0); }
  :global(.js) .show .cap__cta { position: absolute; right: var(--gut); bottom: max(20px, 3svh); opacity: 0; }
  :global(.js) .show [data-in] { opacity: 0; }
  }

  @media (max-width: 809px) {
