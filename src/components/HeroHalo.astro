  .key__figure { width: 100%; height: 100%; }
  .tile { position: relative; display: flex; flex-direction: column; min-height: 0; padding: clamp(10px, 1.5vw, 22px); border-radius: var(--r); background: var(--bg); color: var(--fg); container-type: inline-size; }
  .tile--id { grid-area: 1 / 1; } .tile--ad { grid-area: 1 / 3; } .tile--film { grid-area: 2 / 1; } .tile--web { grid-area: 2 / 3; }
