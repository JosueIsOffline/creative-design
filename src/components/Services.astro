---
interface Servicio { titulo: string; descripcion: string; icono: string }

const servicios: Servicio[] = [
  {
    titulo: 'Identidad visual',
    descripcion: 'Logos, paleta de colores y estilo de marca que te representan.',
    icono: 'palette',
  },
  {
    titulo: 'Flyers',
    descripcion: 'Diseños llamativos para promociones, eventos y redes sociales.',
    icono: 'megaphone',
  },
  {
    titulo: 'Papelería',
    descripcion: 'Tarjetas, facturas y membretes con un acabado profesional.',
    icono: 'stack',
  },
  {
    titulo: 'Personalización',
    descripcion: 'Tazas, camisetas, llaveros y más con tu diseño o foto.',
    icono: 'mug',
  },
  {
    titulo: 'Sublimación',
    descripcion: 'Impresión de alta calidad y duradera sobre distintos materiales.',
    icono: 'flame',
  },
  {
    titulo: 'Redes Sociales',
    descripcion: 'Publicaciones y contenido visual que conectan con tu audiencia.',
    icono: 'heart',
  },
];

const icons: Record<string, string> = {
  palette:
    '<circle cx="12" cy="12" r="7"/><circle cx="9" cy="10" r="1" fill="currentColor" stroke="none"/><circle cx="14" cy="9" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="9.5" cy="14.5" r="1" fill="currentColor" stroke="none"/>',
  megaphone: '<path d="M3 10v4h3l5 4V6l-5 4H3Z"/><path d="M16.5 9a4 4 0 0 1 0 6"/>',
  stack: '<rect x="5" y="7" width="12" height="13" rx="1"/><rect x="8" y="4" width="12" height="13" rx="1"/>',
  mug: '<rect x="4" y="7" width="12" height="11" rx="2"/><path d="M16 9.5h2a2 2 0 0 1 0 4h-2"/><line x1="7" y1="4" x2="7" y2="6"/><line x1="10.5" y1="3" x2="10.5" y2="6"/>',
  flame: '<path d="M12 3c-1.2 2.8-4 4.2-4 7.8a4 4 0 1 0 8 0c0-1-.3-1.8-.8-2.5.1 1.3-.7 2-1.2 1.7.6-2-.3-4.3-2-7Z"/>',
  heart: '<circle cx="9" cy="9" r="3"/><circle cx="15" cy="9" r="3"/><path d="M6.5 11.5 12 18l5.5-6.5"/>',
};
---
<section id="servicios" class="max-w-5xl mx-auto px-6 py-16 scroll-mt-24">
  <div class="text-center mb-10">
    <h2 class="font-display text-2xl font-semibold text-brand-lilac">Servicios</h2>
    <p class="text-gray-400 mt-2">Todo lo que Creative Design hace por ti, de la idea a la pieza final.</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {servicios.map((s) => (
      <div class="service-card rounded-2xl bg-brand-surface border border-gray-800 p-6 text-left">
        <span class="flex items-center justify-center w-11 h-11 rounded-full border border-gray-700 text-brand-lilac" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icono]} />
        </span>
        <h3 class="font-display text-lg font-bold mt-4">{s.titulo}</h3>
        <p class="text-gray-400 text-sm mt-2 leading-relaxed">{s.descripcion}</p>
      </div>
    ))}
  </div>
</section>
