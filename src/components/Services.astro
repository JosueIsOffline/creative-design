---
interface Servicio { titulo: string; descripcion: string; imagen: string }

const servicios: Servicio[] = [
  {
    titulo: 'Identidad visual',
    descripcion: 'Logos, paleta de colores y estilo de marca que te representan.',
    imagen: 'https://images.unsplash.com/photo-1626785774573-4b799315345d?auto=format&fit=crop&w=800&q=80',
  },
  {
    titulo: 'Flyers',
    descripcion: 'Diseños llamativos para promociones, eventos y redes sociales.',
    imagen: 'https://images.unsplash.com/photo-1572044162444-ad60f128bdea?auto=format&fit=crop&w=800&q=80',
  },
  {
    titulo: 'Papelería',
    descripcion: 'Tarjetas, facturas y membretes con un acabado profesional.',
    imagen: 'https://images.unsplash.com/photo-1718670013921-2f144aba173a?auto=format&fit=crop&w=800&q=80',
  },
  {
    titulo: 'Personalización',
    descripcion: 'Tazas, camisetas, llaveros y más con tu diseño o foto.',
    imagen: 'https://images.unsplash.com/photo-1572119865084-43c285814d63?auto=format&fit=crop&w=800&q=80',
  },
  {
    titulo: 'Sublimación',
    descripcion: 'Impresión de alta calidad y duradera sobre distintos materiales.',
    imagen: 'https://images.unsplash.com/photo-1693031630369-bd429a57f115?auto=format&fit=crop&w=800&q=80',
  },
  {
    titulo: 'Redes Sociales',
    descripcion: 'Publicaciones y contenido visual que conectan con tu audiencia.',
    imagen: 'https://images.unsplash.com/photo-1611162616305-c69b3fa7fbe0?auto=format&fit=crop&w=800&q=80',
  },
];

const introImagen = 'https://images.unsplash.com/photo-1716471330463-f475b00f0506?auto=format&fit=crop&w=1600&q=80';
---
<section id="servicios" class="relative scroll-mt-24">
  <div class="film-grain"></div>

  <div id="servicios-intro" class="relative h-screen overflow-hidden">
    <div class="servicios-intro-image absolute inset-0">
      <img src={introImagen} alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
    </div>
    <div class="relative z-10 h-full flex flex-col justify-end px-6 pb-16 max-w-5xl mx-auto">
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-white/70 mb-4">Estudio — Creative Design</span>
      <h2 data-gsap="kinetic-heading" class="font-display text-5xl sm:text-7xl font-bold text-white uppercase tracking-tight leading-[0.9]">
        Servicios
      </h2>
      <p class="text-white/80 mt-4 max-w-md">Todo lo que Creative Design hace por ti, de la idea a la pieza final.</p>
    </div>
  </div>

  <div id="servicios-list" class="max-w-5xl mx-auto px-6 py-16">
    {servicios.map((s, i) => (
      <div class="service-row group relative border-b border-border py-6 sm:py-8 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 sm:gap-6" data-service-image={s.imagen}>
        <h3 data-gsap="kinetic-heading" class="font-display text-3xl sm:text-5xl font-bold uppercase tracking-tight group-hover:text-accent transition-colors">
          {s.titulo}
        </h3>
        <div class="flex items-baseline gap-4 sm:text-right shrink-0 sm:max-w-xs">
          <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
          <p class="font-mono text-xs text-muted leading-relaxed">{s.descripcion}</p>
        </div>
      </div>
    ))}
  </div>

  <div id="service-preview" class="hidden lg:block fixed top-0 left-0 pointer-events-none z-50 opacity-0 w-56 h-40 rounded-xl overflow-hidden" aria-hidden="true">
    <img class="service-preview-blur absolute inset-0 w-full h-full object-cover blur-xl scale-110" />
    <img class="service-preview-sharp absolute inset-0 w-full h-full object-cover opacity-0" />
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Intro pin + Ken Burns: a single cinematic beat before the list, desktop
  // + motion-safe only (pinning fights mobile browser chrome).
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    const intro = document.getElementById('servicios-intro');
    const introImg = intro?.querySelector<HTMLElement>('.servicios-intro-image img');
    if (!intro || !introImg) return;

    gsap.timeline({
      scrollTrigger: {
        trigger: intro,
        start: 'top top',
        end: '+=600',
        pin: true,
        scrub: 0.8,
      },
    }).fromTo(introImg, { scale: 1.15 }, { scale: 1, ease: 'none' });
  });

  // Cursor-following service preview: fine-pointer, hover-capable, motion-safe
  // only — mobile just gets the plain list, no hover mechanism exists there.
  mm.add('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
    const preview = document.getElementById('service-preview');
    const blurImg = preview?.querySelector<HTMLImageElement>('.service-preview-blur');
    const sharpImg = preview?.querySelector<HTMLImageElement>('.service-preview-sharp');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.service-row'));
    if (!preview || !blurImg || !sharpImg || rows.length === 0) return;

    const moveX = gsap.quickTo(preview, 'x', { duration: 0.4, ease: 'power3.out' });
    const moveY = gsap.quickTo(preview, 'y', { duration: 0.4, ease: 'power3.out' });

    function handleMove(e: PointerEvent) {
      moveX(e.clientX + 24);
      moveY(e.clientY - 80);
    }

    rows.forEach((row) => {
      const src = row.dataset.serviceImage;
      if (!src) return;

      row.addEventListener('pointerenter', (e) => {
        blurImg.src = src;
        sharpImg.src = src;
        gsap.set(sharpImg, { opacity: 0 });
        // Snap to the pointer's current position immediately — if the
        // cursor arrived here via scroll (not a mousemove), there is no
        // pointermove event to wait for, and the preview would otherwise
        // flash at its default (0,0) position.
        gsap.set(preview, { x: e.clientX + 24, y: e.clientY - 80 });
        gsap.to(preview, { opacity: 1, duration: 0.2 });
        gsap.to(sharpImg, { opacity: 1, duration: 0.4, delay: 0.05 });
        window.addEventListener('pointermove', handleMove);
      });

      row.addEventListener('pointerleave', () => {
        gsap.to(preview, { opacity: 0, duration: 0.2 });
        window.removeEventListener('pointermove', handleMove);
      });
    });
  });
</script>
