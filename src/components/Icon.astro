---
interface Props { name: 'arrow-right' | 'arrow-left' | 'arrow-diagonal' | 'close'; class?: string }
const { name, class: className = 'w-4 h-4' } = Astro.props;

// Plain line-art SVGs instead of Unicode arrows/✕ — those render as
// colorful emoji glyphs on some phone keyboards/fonts, which clashes with
// the monochrome brand look.
const paths: Record<Props['name'], string> = {
  'arrow-right': '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
  'arrow-left': '<line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>',
  'arrow-diagonal': '<line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/>',
  close: '<line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>',
};
---
<svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
