---
---
<div id="card-expand-backdrop" class="fixed inset-0 z-40 bg-black/80 opacity-0 pointer-events-none transition-opacity duration-300 ease-out"></div>

<script>
  import { addToCartWithFx } from '../scripts/add-to-cart-fx';

  // Looked up on use: each page navigation brings a fresh backdrop element.
  const backdrop = () => document.getElementById('card-expand-backdrop');

  let expandedArticle: HTMLElement | null = null;
  let expandedLink: HTMLElement | null = null;

  // The close button fades/shrinks out before the card fades away, and in
  // only once the card has faded in.
  const REVEAL_FADE_MS = 200;
  const CARD_FADE_MS = 220; // keep in sync with card-fade in global.css

  function getRevealEls(article: HTMLElement) {
    return [article.querySelector<HTMLElement>('.card-close')].filter((el): el is HTMLElement => !!el);
  }

  function closeExpanded() {
    if (!expandedArticle || !expandedLink) return;
    const article = expandedArticle;
    const link = expandedLink;
    expandedArticle = null;
    expandedLink = null;

    // Height animation is only for phase 2 of opening (see openExpanded) —
    // must be off before the box's position:fixed toggles off again here.
    article.classList.remove('height-anim');

    const revealEls = getRevealEls(article);
    revealEls.forEach((el) => el.classList.add('is-hiding'));

    const collapse = () => {
      const applyClosed = () => {
        article.classList.remove('is-expanded');
        revealEls.forEach((el) => el.classList.remove('is-hiding'));
        link.style.minHeight = '';
        backdrop()?.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      };

      // Fades out where it is, then drops back into the grid.
      article.classList.add('is-leaving');
      setTimeout(() => { article.classList.remove('is-leaving'); applyClosed(); }, CARD_FADE_MS);
    };

    setTimeout(collapse, revealEls.length ? REVEAL_FADE_MS : 0);
  }

  function openExpanded(link: HTMLElement, article: HTMLElement) {
    if (expandedArticle) closeExpanded();

    // Lock the link's height so the grid doesn't collapse once the card
    // inside it switches to position:fixed.
    link.style.minHeight = `${link.getBoundingClientRect().height}px`;

    const revealEls = getRevealEls(article);
    // is-precollapsed forces the button's space to 0 only for this initial
    // growth, so the box's view-transition snapshot doesn't include an
    // empty gap reserved for a button nobody sees yet.
    revealEls.forEach((el) => el.classList.add('is-hiding', 'is-precollapsed'));

    const applyOpen = () => {
      article.classList.add('is-expanded');
      backdrop()?.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    };

    const revealButtons = () => {
      // Only turn on the height transition once the box has finished
      // moving/resizing into position:fixed — this is purely for the
      // button's own reveal growth, never the position-changing motion.
      article.classList.add('height-anim');
      requestAnimationFrame(() => {
        revealEls.forEach((el) => el.classList.remove('is-hiding', 'is-precollapsed'));
      });
    };

    // No flight from the grid: the card just fades in, centred, so the
    // photo never travels or stretches.
    applyOpen();
    setTimeout(revealButtons, CARD_FADE_MS);

    expandedArticle = article;
    expandedLink = link;
  }

  // Capture phase + stopImmediatePropagation: data-product-trigger is a real
  // <a href>, and Astro's ClientRouter has its own document click listener
  // that intercepts same-origin links and starts its own soft navigation.
  // Listeners on the same node/phase run in attachment order, and
  // ClientRouter's (injected in <head>) attaches before this one — by the
  // time preventDefault() ran here in the bubble phase, Astro's navigation
  // had already started. Running first, in capture, and fully neutralizing
  // the event is the only way to reliably win that race.
  document.addEventListener(
    'click',
    (e) => {
      const target = e.target as HTMLElement;

      const closeBtn = target.closest('.card-close');
      if (closeBtn) {
        e.preventDefault();
        e.stopImmediatePropagation();
        closeExpanded();
        return;
      }

      const addBtn = target.closest<HTMLElement>('.card-add-to-cart');
      if (addBtn) {
        e.preventDefault();
        e.stopImmediatePropagation();
        const raw = addBtn.dataset.product;
        if (raw) addToCartWithFx(addBtn, JSON.parse(raw));
        return;
      }

      const trigger = target.closest<HTMLElement>('[data-product-trigger]');
      if (trigger) {
        const article = trigger.querySelector<HTMLElement>('.product-card');
        if (article) {
          e.preventDefault();
          e.stopImmediatePropagation();
          if (article.classList.contains('is-expanded')) {
            closeExpanded();
          } else {
            openExpanded(trigger, article);
          }
          return;
        }
      }

      if (target === backdrop()) {
        closeExpanded();
      }
    },
    true
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && expandedArticle) closeExpanded();
  });
</script>
